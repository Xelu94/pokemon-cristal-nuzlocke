+SECTION "Ulex encounters", ROMX
+
+; Sixteen independently persistent disguises. A second encounter is locked
+; until another badge is earned, even when Kanto gyms are done out of order.
+UlexCanBattle::
+	xor a
+	ld [wUlexDidBattle], a
+	ld hl, wJohtoBadges
+	ld b, 2
+	call CountSetBits
+	ld a, [wNumSetBits]
+	ld [wUlexBadgeCount], a
+	ld e, a
+	ld d, 0
+	ld hl, EVENT_ULEX_BADGE_BASE
+	add hl, de
+	ld d, h
+	ld e, l
+	ld b, CHECK_FLAG
+	call EventFlagAction
+	ld a, c
+	and a
+	ld a, 0
+	jr nz, .done
+	inc a
+.done
+	ld [wScriptVar], a
+	ret
+
+UlexMarkMilestone::
+	ld a, 1
+	ld [wUlexDidBattle], a
+	ld a, [wUlexBadgeCount]
+	ld e, a
+	ld d, 0
+	ld hl, EVENT_ULEX_BADGE_BASE
+	add hl, de
+	ld d, h
+	ld e, l
+	ld b, SET_FLAG
+	jp EventFlagAction
+
+UlexCommitEncounter::
+; Commit before map reload: a whiteout ends the parent script immediately.
+; Rejected battles return DRAW and must not consume the encounter.
+	call UlexClearSoftLevel
+	ld a, [wBattleResult]
+	and $f
+	cp DRAW
+	ret z
+	call UlexMarkMilestone
+	ld a, [wUlexLocation]
+	ld e, a
+	ld d, 0
+	ld hl, EVENT_ULEX_LOCATION_BASE
+	add hl, de
+	ld d, h
+	ld e, l
+	ld b, SET_FLAG
+	jp EventFlagAction
+
+UlexCountDeaths:
+	ld a, [wCurPartyMon]
+	push af
+	xor a
+	ld [wCurPartyMon], a
+	ld c, a
+.loop
+	ld a, [wPartyCount]
+	ld b, a
+	ld a, [wCurPartyMon]
+	cp b
+	jr nc, .done
+	push bc
+	farcall NuzlockeCheckPartyMonDead
+	pop bc
+	jr z, .next
+	inc c
+.next
+	ld hl, wCurPartyMon
+	inc [hl]
+	jr .loop
+.done
+	pop af
+	ld [wCurPartyMon], a
+	ret
+
+UlexPrepareBattle::
+	call UlexCountDeaths
+	ld a, c
+	ld [wUlexPreDeaths], a
+	ld a, DRAW
+	ld [wBattleResult], a
+	ret
+
+UlexSelectTeam::
+	farcall GetCurrentLevelCap
+	ld hl, .Caps
+	ld c, 1
+.loop
+	ld a, [hli]
+	cp b
+	jr nc, .found
+	inc c
+	jr .loop
+.found
+	ld a, c
+	ld [wOtherTrainerID], a
+	; Only the Route 31 Ulex met before the first badge has softened levels:
+	; bit 7 of wUlexLocation tells ClampProgressionLevel while his party is read.
+	ld a, [wUlexLocation]
+	and a
+	ret nz
+	ld a, [wUlexBadgeCount]
+	and a
+	ret nz
+	ld a, $80
+	ld [wUlexLocation], a
+	ret
+.Caps
+	db 19, 24, 29, 35, 40, 44, 48, 53, 65, 67, 70, 73, 75, 77, 80, 83, 85, 95, 100
+
+UlexClearSoftLevel::
+	ld a, [wUlexLocation]
+	and $7f
+	ld [wUlexLocation], a
+	ret
+
+; Called before generating a trainer mon, so EXP and all stats use the cap.
+UlexOverrideLevel::
+	push af
+	ld a, [wOtherTrainerClass]
+	cp ULEX
+	jr nz, .done
+	farcall GetCurrentLevelCap
+	ld a, b
+	ld [wCurPartyLevel], a
+.done
+	pop af
+	ret
+
+UlexCheckNewDeaths::
+	call UlexCountDeaths
+	ld a, [wUlexPreDeaths]
+	cp c
+	ld a, 0
+	jr nc, .done
+	inc a
+.done
+	ld [wScriptVar], a
+	ret
+
+UlexStealLivingMon::
+; Replace a randomly selected living non-egg. A full party needs no free slot.
+; If there are no living mons, the normal Nuzlocke whiteout handles the run.
+	xor a
+	ld [wUlexCandidateCount], a
+	ld [wCurPartyMon], a
+.scan
+	ld a, [wPartyCount]
+	ld b, a
+	ld a, [wCurPartyMon]
+	cp b
+	jr nc, .choose
+	ld e, a
+	ld d, 0
+	ld hl, wPartySpecies
+	add hl, de
+	ld a, [hl]
+	cp EGG
+	jr z, .next
+	farcall NuzlockeCheckPartyMonDead
+	jr nz, .next
+	ld a, MON_HP
+	call GetPartyParamLocation
+	ld a, [hli]
+	or [hl]
+	jr z, .next
+	ld a, [wUlexCandidateCount]
+	ld e, a
+	ld d, 0
+	ld hl, wUlexCandidates
+	add hl, de
+	ld a, [wCurPartyMon]
+	ld [hl], a
+	ld hl, wUlexCandidateCount
+	inc [hl]
+.next
+	ld hl, wCurPartyMon
+	inc [hl]
+	jr .scan
+.choose
+	ld a, [wUlexCandidateCount]
+	and a
+	ret z
+	ld b, a
+	call RandomRange
+	ld e, a
+	ld d, 0
+	ld hl, wUlexCandidates
+	add hl, de
+	ld a, [hl]
+	ld [wCurPartyMon], a
+	ld a, MON_SPECIES
+	call GetPartyParamLocation
+	ld a, [hl]
+	ld [wNamedObjectIndex], a
+	call GetPokemonName
+	ld hl, wStringBuffer1
+	ld de, wUlexStolenName
+	ld bc, MON_NAME_LENGTH
+	call CopyBytes
+	xor a
+	ld [wPokemonWithdrawDepositParameter], a
+	farcall RemoveMonFromPartyOrBox
+	ld a, RATTATA
+	ld [wCurPartySpecies], a
+	ld a, 5
+	ld [wCurPartyLevel], a
+	xor a
+	ld [wMonType], a
+	ld [wBattleMode], a
+	predef TryAddMonToParty
+	ld a, [wPartyCount]
+	dec a
+	ld [wCurPartyMon], a
+	ld a, MON_MOVES
+	call GetPartyParamLocation
+	ld a, SPLASH
+	ld [hli], a
+	xor a
+	ld [hli], a
+	ld [hli], a
+	ld [hl], a
+	ld a, MON_PP
+	call GetPartyParamLocation
+	ld a, 40
+	ld [hli], a
+	xor a
+	ld [hli], a
+	ld [hli], a
+	ld [hl], a
+	ld a, MON_OT_ID
+	call GetPartyParamLocation
+	ld a, $be
+	ld [hli], a
+	ld [hl], $ef
+	ld hl, wPartyMonNicknames
+	ld a, [wCurPartyMon]
+	call SkipNames
+	ld d, h
+	ld e, l
+	ld hl, .Nickname
+	ld bc, MON_NAME_LENGTH
+	call CopyBytes
+	ld hl, wPartyMonOTs
+	ld a, [wCurPartyMon]
+	call SkipNames
+	ld d, h
+	ld e, l
+	ld hl, .OT
+	ld bc, NAME_LENGTH
+	jp CopyBytes
+.Nickname
+	db "ZURULLO@@@@"
+.OT
+	db "ULEX@@@@@@@"
+
+UlexBattleScript::
+	faceplayer
+	callasm UlexCanBattle
+	iffalse .WaitForBadge
+	applymovementlasttalked .Spin
+	loadmem wUlexRevealLoading, 1
+	variablesprite SPRITE_COPYCAT, SPRITE_ROCKET
+	special LoadUsedSpritesGFX
+	loadmem wUlexRevealLoading, 0
+	faceplayer
+	opentext
+	writetext .RevealText
+	waitbutton
+	closetext
+	callasm UlexPrepareBattle
+	winlosstext .WinText, .LossText
+	loadtrainer ULEX, ULEX1
+	callasm UlexSelectTeam
+	startbattle
+	readmem wBattleResult
+	ifequal DRAW, .Refused
+	callasm UlexCommitEncounter
+	reloadmapafterbattle
+	opentext
+	callasm UlexCheckNewDeaths
+	iftrue .Steal
+	readmem wBattleResult
+	ifnotequal WIN, .NoReward
+	writetext .GiftText
+	promptbutton
+	callasm ReceiveRandomTM
+	iftrue .GiftDone
+	writetext .FullText
+	waitbutton
+	sjump .Done
+.GiftDone
+	itemnotify
+	sjump .Done
+.Steal
+	callasm UlexStealLivingMon
+	writetext .StealText
+	waitbutton
+	sjump .Done
+.NoReward
+	writetext .LossText
+	waitbutton
+.Done
+	closetext
+	end
+.WaitForBadge
+	opentext
+	writetext .WaitText
+	waitbutton
+	closetext
+	end
+.Refused
+	callasm UlexClearSoftLevel
+	end
+.Spin
+	turn_head DOWN
+	turn_head LEFT
+	turn_head UP
+	turn_head RIGHT
+	turn_head DOWN
+	turn_head LEFT
+	turn_head UP
+	turn_head RIGHT
+	turn_head DOWN
+	step_end
+.RevealText
+	text "ULEX EL LADRÓN:"
+	para "Eyyy que pasaaa,"
+	line "dame todos tus"
+	cont "#MON."
+	done
+.WinText
+	text "¡Ufff me ganaste"
+	line "wachin, bien"
+	cont "hecho puerco!"
+	done
+.LossText
+	text "¡Jajaja, wachin!"
+	line "Te falta calle."
+	done
+.GiftText
+	text "¡¡Toma esto anda"
+	line "y déjame en paz!!"
+	done
+.StealText
+	text "Me ganaste puerco,"
+	line "pero..."
+	para "Te voy a quitar"
+	line "un #MON, por"
+	cont "tolai, por haber"
+	cont "perdido un #MON"
+	cont "y ser tan manco."
+	para "¡Te quito otro!"
+	line "Jajajaja me llevo"
+	cont "a este:"
+	para "@"
+	text_ram wUlexStolenName
+	text "."
+	line "¡Chao wachin!"
+	para "Te dejo a ZURULLO."
+	done
+.WaitText
+	text "Ahora no toca."
+	line "Gana otra medalla"
+	cont "y sigue tu camino."
+	done
+.FullText
+	text "No cabe la MT."
+	line "Libera espacio."
+	done
+
+SECTION UNION "Unused Map Buffer", WRAM0
+	ds 1 ; the first byte belongs to the bag category
+wUlexBadgeCount:: db
+wUlexDidBattle:: db
+wUlexPreDeaths:: db
+wUlexCandidateCount:: db
+wUlexCandidates:: ds PARTY_LENGTH
+wUlexStolenName:: ds MON_NAME_LENGTH
