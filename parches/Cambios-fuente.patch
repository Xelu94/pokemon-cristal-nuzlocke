+	setevent EVENT_FORCE_SHINY_GIFT
+	givepoke CHARIZARD, 100
+	givepokemail SuperTitoMail
+	clearevent EVENT_FORCE_SHINY_GIFT
+	setevent EVENT_SUPER_LEAGUE_BEAT_TITO
+	writetext SuperTitoLetterText
+	waitbutton
