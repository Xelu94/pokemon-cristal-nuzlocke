diff --git a/tools/test_v2_field.py b/tools/test_v2_field.py
new file mode 100644
index 0000000..c586169
--- /dev/null
+++ b/tools/test_v2_field.py
@@ -0,0 +1,236 @@
+"""Execute assembled Fairy and field-HM routines with PyBoy, without saves.
+
+Usage: python tools/test_v2_field.py pokecristal.gbc
+"""
+import io
+import json
+import re
+import sys
+from pathlib import Path
+
+from pyboy import PyBoy
+
+ROM = Path(sys.argv[1])
+SYMBOLS = {}
+for line in ROM.with_suffix('.sym').read_text().splitlines():
+    match = re.match(r'([\da-fA-F]+):([\da-fA-F]+)\s+(\S+)', line)
+    if match:
+        SYMBOLS[match[3]] = (int(match[1], 16), int(match[2], 16))
+
+
+class CPU:
+    def __init__(self):
+        self.p = PyBoy(io.BytesIO(ROM.read_bytes()), window='null',
+                       sound_emulated=False, log_level='ERROR')
+        self.p.set_emulation_speed(0)
+        self.p.hook_register(0, 0x100, self.start, None)
+        self.p.hook_register(0, 0x102, self.finish, None)
+        self.p.memory[0, 0x104] = 0x18
+        self.p.memory[0, 0x105] = 0xfe
+
+    def address(self, name):
+        return SYMBOLS[name][1]
+
+    def put(self, name, value, offset=0):
+        self.p.memory[self.address(name) + offset] = value
+
+    def get(self, name, offset=0):
+        return self.p.memory[self.address(name) + offset]
+
+    def start(self, _):
+        name, setup, registers = self.pending
+        self.p.memory[0xc000:0xe000] = [0] * 0x2000
+        self.p.memory[0xff80:0xffff] = [0] * 0x7f
+        self.p.memory[0xff40] = 0
+        self.p.memory[0xffff] = 0
+        self.p.memory[0xff0f] = 0
+        for who in ['BattleMon', 'EnemyMon']:
+            for stat in ['Attack', 'Defense', 'SpclAtk', 'SpclDef']:
+                self.put('w' + who + stat, 0)
+                self.put('w' + who + stat, 100, 1)
+        for who in ['Player', 'Enemy']:
+            for stat in ['Atk', 'Def', 'SAtk', 'SDef']:
+                self.put('w' + who + stat + 'Level', 7)
+        setup(self)
+        self.p.memory[0xff50] = 1
+        bank, pointer = SYMBOLS[name]
+        self.p.memory[0x2000] = bank or 1
+        self.put('hROMBank', bank or 1)
+        reg = self.p.register_file
+        reg.SP = 0xdff0
+        self.p.memory[0xdff0:0xdff2] = [2, 1]
+        for key in ['A', 'F', 'B', 'C', 'D', 'E', 'HL']:
+            setattr(reg, key, 0)
+        for key, value in registers.items():
+            setattr(reg, key, value)
+        reg.PC = pointer
+
+    def finish(self, _):
+        reg = self.p.register_file
+        self.result = {key: getattr(reg, key) for key in ['A', 'F', 'B', 'C', 'D', 'E']}
+        reg.PC = 0x104
+
+    def run(self, name, setup=lambda r: None, **registers):
+        self.pending = name, setup, registers
+        self.result = None
+        if self.p.memory[0xff50]:
+            self.p.register_file.PC = 0x100
+        for _ in range(160):
+            self.p.tick(1, False, False)
+            if self.result is not None:
+                return self.result
+        raise AssertionError('No return from ' + name)
+
+
+cpu = CPU()
+results = []
+
+
+def passed(name):
+    results.append({'test': name, 'passed': True})
+
+
+def party(r):
+    # First party member is dead, second is living; neither knows any move.
+    r.put('wPartyCount', 2)
+    r.put('wPartySpecies', 25)
+    r.put('wPartySpecies', 133, 1)
+    r.put('wPartySpecies', 255, 2)
+    r.put('wPartyMon1CaughtLocation', 128)
+    r.put('wPartyMon2HP', 40, 1)
+    r.put('wCurPartyMon', 1)
+    r.put('wCurPartySpecies', 133)
+    r.put('wJohtoBadges', 255)
+    r.put('wMapGroup', 24)
+    r.put('wMapNumber', 4)  # New Bark Town, stock map data.
+    for n in range(7):
+        r.put('wTMsHMs', 1, 50 + n)
+
+
+try:
+    # Every Fairy interaction is evaluated by the actual battle lookup routine.
+    for atk, target, expected in [(28, 1, 20), (28, 26, 20), (28, 27, 20),
+                                   (28, 20, 5), (28, 3, 5), (28, 9, 5),
+                                   (1, 28, 5), (3, 28, 20), (7, 28, 5),
+                                   (26, 28, 0), (27, 28, 5), (9, 28, 20),
+                                   (8, 9, 10), (27, 9, 10)]:
+        def setup(r, a=atk, t=target):
+            r.put('wPlayerMoveStructType', a | 0x80)
+            r.put('wEnemyMonType1', t)
+            r.put('wEnemyMonType2', t)
+        cpu.run('BattleCheckTypeMatchup', setup)
+        assert cpu.get('wTypeMatchup') == expected, (atk, target, expected)
+        passed(f'type matchup {atk} against {target}')
+
+    fairy_species = {35: (28, 28), 36: (28, 28), 39: (0, 28), 40: (0, 28),
+                     122: (24, 28), 173: (28, 28), 174: (0, 28),
+                     175: (28, 28), 176: (28, 2), 183: (21, 28),
+                     184: (21, 28), 209: (28, 28), 210: (28, 28)}
+    for species, types in fairy_species.items():
+        cpu.run('GetBaseData', lambda r, n=species: r.put('wCurSpecies', n))
+        assert (cpu.get('wBaseType1'), cpu.get('wBaseType2')) == types
+    passed('all 13 existing Fairy species have canonical types')
+
+    cpu.run('GetTypeName', lambda r: r.put('wNamedObjectIndex', 28))
+    assert [cpu.get('wStringBuffer1', n) for n in range(5)] == [0x87, 0x80, 0x83, 0x80, 0x50]
+    passed('Fairy type name renders HADA')
+
+    hp_types = set()
+    for atk in range(4):
+        for defense in range(4):
+            cpu.run('HiddenPowerDamage', lambda r, a=atk, d=defense:
+                    r.put('wBattleMonDVs', a * 16 + d))
+            hp_types.add(cpu.get('wPlayerMoveStructType') & 63)
+    assert hp_types == set(range(1, 6)) | {7, 8, 9} | set(range(20, 28)), hp_types
+    passed('Hidden Power retains its original 16 possible types')
+
+    for index, move in enumerate([15, 19, 57, 70, 148, 250, 127]):
+        got = cpu.run('CheckPartyMove', party, D=move)
+        assert not got['F'] & 16, (move, got)
+        assert cpu.get('wCurPartyMon') == 1
+        passed(f'HM {index + 1} works with no learned moves and skips dead member')
+        def missing(r, n=index):
+            party(r)
+            r.put('wTMsHMs', 0, 50 + n)
+        got = cpu.run('CheckPartyMove', missing, D=move)
+        assert got['F'] & 16, (move, got)
+        passed(f'HM {index + 1} cannot be used without owning it')
+
+    for situation in ['all_dead', 'egg_only', 'run_ended']:
+        def no_user(r, s=situation):
+            party(r)
+            if s == 'all_dead':
+                r.put('wPartyMon2CaughtLocation', 128)
+            elif s == 'egg_only':
+                r.put('wPartySpecies', 253, 1)
+            else:
+                r.put('wNuzlockeRunEnded', 1)
+        got = cpu.run('CheckFieldMoveHM', no_user, D=57)
+        assert got['F'] & 16, (situation, got)
+        passed('HM access denied for ' + situation)
+
+    def learned_headbutt(r):
+        party(r)
+        r.put('wPartyMon1Moves', 29)
+        r.put('wPartyMon2Moves', 29)
+    got = cpu.run('CheckPartyMove', learned_headbutt, D=29)
+    assert not got['F'] & 16 and cpu.get('wCurPartyMon') == 1
+    passed('non-HM field moves still require a living member that knows the move')
+    got = cpu.run('CheckPartyMove', party, D=29)
+    assert got['F'] & 16
+    passed('owning HMs does not grant unrelated Headbutt')
+
+    cpu.run('GetMonSubmenuItems', party)
+    items = [cpu.get('wMonSubmenuItems', n) for n in range(cpu.get('wMonSubmenuCount'))]
+    assert 6 in items, items  # MONMENUITEM_FLASH
+    assert len(items) <= 8
+    passed('Flash action appears from HM ownership alone')
+
+    def full_field_menu(r):
+        party(r)
+        for n, move in enumerate([91, 100, 135, 29]):  # Dig/Teleport/Softboiled/Headbutt.
+            r.put('wPartyMon2Moves', move, n)
+    cpu.run('GetMonSubmenuItems', full_field_menu)
+    assert cpu.get('wMonSubmenuCount') == 8
+    assert cpu.get('wMonSubmenuItems') == 6
+    assert cpu.get('wMonSubmenuItems', 8) == 255
+    passed('Flash plus four known field moves never overflows the eight-entry menu')
+
+    def fly(r):
+        party(r)
+        r.put('wPokegearMapCursorLandmark', 6)  # Violet City.
+        r.put('wVisitedSpawns', 1, 2)  # SPAWN_VIOLET=16.
+    got = cpu.run('PokegearTryFly', fly)
+    assert not got['F'] & 16, got
+    assert cpu.get('wDefaultSpawnpoint') == 16
+    assert cpu.get('wUnusedPokegearByte') == 1
+    assert cpu.get('wJumptableIndex') & 128
+    passed('Pokégear A selects a visited city for Fly')
+
+    for situation in ['unvisited', 'missing_badge', 'missing_hm', 'indoors', 'route']:
+        def denied(r, s=situation):
+            fly(r)
+            if s == 'unvisited':
+                r.put('wVisitedSpawns', 0, 2)
+            elif s == 'missing_badge':
+                r.put('wJohtoBadges', 0xdf)
+            elif s == 'missing_hm':
+                r.put('wTMsHMs', 0, 51)
+            elif s == 'indoors':
+                r.put('wMapNumber', 5)  # Elm's Lab.
+            else:
+                r.put('wPokegearMapCursorLandmark', 2)  # Route 29 has no Flypoint.
+        got = cpu.run('PokegearTryFly', denied)
+        assert got['F'] & 16, (situation, got)
+        assert not cpu.get('wUnusedPokegearByte')
+        passed('Fly denied for ' + situation)
+
+    cpu.run('QueuePokegearFlyScript')
+    bank, pointer = SYMBOLS['FlyFunction.FlyScript']
+    assert cpu.get('wQueuedScriptBank') == bank
+    assert cpu.get('wQueuedScriptAddr') + 256 * cpu.get('wQueuedScriptAddr', 1) == pointer
+    passed('map flight queues original animated Fly field script')
+finally:
+    cpu.p.stop(save=False)
+
+print(json.dumps({'rom': str(ROM), 'passed': len(results), 'results': results}, indent=2))
