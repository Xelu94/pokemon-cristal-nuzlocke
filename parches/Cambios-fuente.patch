+PUSHS
+SECTION "Random trades custom", ROMX
+
+ChooseBalancedNPCTrade::
+; wCurPartySpecies -> wOTTrademonSpecies. Eight candidates per species, uniformly selected.
+; Species pools preserve evolution stage and comparable base-stat totals.
+	call Random
+	and 7
+	ld e, a
+	ld d, 0
+	push de
+	ld a, [wCurPartySpecies]
+	dec a
+	ld hl, BalancedTradePools
+	ld bc, 8
+	call AddNTimes
+	pop de
+	add hl, de
+	ld a, [hl]
+	ld [wOTTrademonSpecies], a
+	ret
+
+INCLUDE "data/events/balanced_trade_pools.asm"
+POPS
