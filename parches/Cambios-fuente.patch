+"""Draw the title-screen line "RADICAL CRISTAL" above the copyright line of
+gfx/title/nuzlocke_branding.png (160x16, two shades). Run from the source root."""
+from pathlib import Path
+from PIL import Image
+
+GLYPHS = {
+    'R': ['XXXXXX.', 'X.....X', 'X.....X', 'XXXXXX.', 'X...X..', 'X....X.', 'X.....X'],
+    'A': ['...X...', '..X.X..', '..X.X..', '.X...X.', '.XXXXX.', 'X.....X', 'X.....X'],
+    'D': ['XXXXXX.', 'X.....X', 'X.....X', 'X.....X', 'X.....X', 'X.....X', 'XXXXXX.'],
+    'I': ['XXXXX', '..X..', '..X..', '..X..', '..X..', '..X..', 'XXXXX'],
+    'C': ['..XXXX.', '.X....X', 'X......', 'X......', 'X......', '.X....X', '..XXXX.'],
+    'L': ['X......', 'X......', 'X......', 'X......', 'X......', 'X......', 'XXXXXXX'],
+    'S': ['.XXXX..', 'X....X.', 'X......', '.XXXXX.', '......X', 'X.....X', '.XXXXX.'],
+    'T': ['XXXXXXX', '...X...', '...X...', '...X...', '...X...', '...X...', '...X...'],
+}
+TEXT = 'RADICAL CRISTAL'
+SPACE = 5
+DARK, LIGHT = 85, 255
+
+path = Path('gfx/title/nuzlocke_branding.png')
+image = Image.open(path).convert('L')
+for y in range(8):
+    for x in range(image.width):
+        image.putpixel((x, y), LIGHT)
+width = sum(SPACE if c == ' ' else len(GLYPHS[c][0]) for c in TEXT) + len(TEXT) - 1
+x = (image.width - width) // 2
+for char in TEXT:
+    if char == ' ':
+        x += SPACE + 1
+        continue
+    for gy, row in enumerate(GLYPHS[char]):
+        for gx, bit in enumerate(row):
+            if bit == 'X':
+                image.putpixel((x + gx, gy), DARK)
+    x += len(GLYPHS[char][0]) + 1
+image.save(path)
+print('title branding: RADICAL CRISTAL, width', width)
diff --git a/tools/build_tito_sprite.py b/tools/build_tito_sprite.py
new file mode 100644
index 0000000..16d9ea5
--- /dev/null
+++ b/tools/build_tito_sprite.py
@@ -0,0 +1,41 @@
+"""Compile Tito's native pixel-grid source to PNG and LR35902-ready 2bpp.
+
+The PNG is an editable preview, the textual grid is the source of truth. Do not
+rescale the large reference sheet: it drops eyes and contours at 16x16. The
+engine requires front/back/LEFT, followed by complete alternate frames.
+"""
+from pathlib import Path
+from PIL import Image
+
+root = Path(__file__).resolve().parents[1]
+source = root / 'gfx/sprites/tito_xeluis.pixels'
+frames = {}
+name = None
+for row in source.read_text(encoding='utf8').splitlines():
+    if not row or row.startswith(';'):
+        continue
+    if row.startswith('['):
+        name = row.strip('[]')
+        frames[name] = []
+    else:
+        assert len(row) == 16 and set(row) <= set('.yr#'), (name, row)
+        frames[name].append(row)
+assert list(frames) == ['front', 'back', 'left']
+assert all(len(rows) == 16 for rows in frames.values())
+
+shades = {'.': 255, 'y': 170, 'r': 85, '#': 0}
+image = Image.new('L', (16, 96), 255)
+def breathe(rows):
+    new = list(rows)
+    for y in range(11, 0, -1):
+        new[y] = rows[y - 1]
+    new[0] = '.' * 16
+    return new
+
+
+for index, rows in enumerate(list(frames.values()) + [breathe(r) for r in frames.values()]):
+    for y, row in enumerate(rows):
+        for x, char in enumerate(row):
+            image.putpixel((x, index * 16 + y), shades[char])
+image.save(root / 'gfx/sprites/tito_xeluis.png')
+print('Tito native artwork: front/back/LEFT + three idle frames (head and torso one pixel lower), 16x96.')
diff --git a/tools/convert_tito_assets.py b/tools/convert_tito_assets.py
new file mode 100644
index 0000000..62c069a
--- /dev/null
+++ b/tools/convert_tito_assets.py
@@ -0,0 +1,55 @@
+"""Build Tito's native sprite and the title branding.
+
+The reviewed 16x16 source lives in gfx/sprites/tito_xeluis.pixels. The engine
+expects front, back and LEFT; the opposite profile is mirrored in hardware.
+Large reference sheets are no longer resized automatically because that loses
+the eye, face and outline pixels. build_tito_sprite.py compiles the native art.
+The title text uses the game's own font, with proportional spacing for its
+copyright line so the complete requested credit fits on the 160px screen.
+"""
+import re
+import sys
+from pathlib import Path
+from PIL import Image
+
+root = Path(__file__).resolve().parents[1]
+# The 16x16 native source preserves face details and the engine's LEFT pose.
+import runpy
+runpy.run_path(str(root / 'tools/build_tito_sprite.py'), run_name='__main__')
+
+font = Image.open(root / "gfx/font/font.png").convert("L")
+mapping = {}
+for char, number in re.findall(r'charmap "(.)",\s*\$([0-9a-f]+)', (root / "constants/charmap.asm").read_text(encoding="utf-8")):
+    mapping[char] = int(number, 16)
+
+def glyph(char):
+    if char == "©":
+        tile = Image.new("L", (8, 8), 255)
+        for y, line in enumerate(("        ", "  ###   ", " #   #  ", "# ### # ", "# #   # ", "# ### # ", " #   #  ", "  ###   ")):
+            for x, pixel in enumerate(line):
+                if pixel == "#":
+                    tile.putpixel((x, y), 0)
+        return tile
+    index = mapping[char] - 0x80
+    return font.crop(((index % 16) * 8, (index // 16) * 8, (index % 16 + 1) * 8, (index // 16 + 1) * 8))
+
+branding = Image.new("L", (160, 16), 255)
+for row, text in enumerate(("CRISTAL NUZLOCKE", "©2026 Tito Xeluis inc.")):
+    tiles = []
+    for char in text:
+        if char == " ":
+            tiles.append(Image.new("L", (4, 8), 255))
+            continue
+        tile = glyph(char)
+        box = Image.eval(tile, lambda value: 255-value).getbbox()
+        tile = tile.crop((box[0], 0, box[2], 8)) if box else tile
+        tiles.append(tile)
+    width = sum(tile.width + 1 for tile in tiles) - 1
+    assert width <= 160, (text, width)
+    left = (160-width) // 2
+    for tile in tiles:
+        # Palette 7 uses index 2 for white over its black index 0 background.
+        tile = tile.point(lambda value: 85 if value < 128 else 255)
+        branding.paste(tile, (left, row * 8))
+        left += tile.width + 1
+branding.save(root / "gfx/title/nuzlocke_branding.png")
diff --git a/tools/convert_tito_v3.py b/tools/convert_tito_v3.py
new file mode 100644
index 0000000..991db61
--- /dev/null
+++ b/tools/convert_tito_v3.py
@@ -0,0 +1,60 @@
+"""Convert supplied pixel-art references to GBC palettes and tile dimensions.
+
+No AI generation: deterministic format conversion of the user's artwork.
+Overworld source has 16 logical pixels at exactly 10x scale. Preserve those
+pixels: shrinking their bounding box made the body too thin. The engine expects
+front/back/LEFT, plus a second set of 12 tiles for walking even on standing NPCs.
+"""
+import sys
+from pathlib import Path
+from PIL import Image
+
+root = Path(__file__).resolve().parents[1]
+assets = Path(sys.argv[1])
+sheet = Image.open(assets/'npc_tito_xeluis.png').convert('RGB')
+out = Image.new('L',(16,96),255)
+for direction,left in enumerate((20,205,575)):
+    logical=sheet.crop((left,16,left+160,176)).resize((16,16),Image.Resampling.NEAREST)
+    frame=Image.new('L',(16,16),255)
+    # Exact four native colors, distinguished from the source beige background.
+    for y in range(16):
+        for x in range(16):
+            r,g,b=logical.getpixel((x,y))
+            value=255 if b>110 else 0 if r<100 else 170 if g>120 else 85
+            frame.putpixel((x,y),value)
+    out.paste(frame,(0,direction*16))
+    # This NPC stays in place. Duplicate valid idle frames rather than letting
+    # GetUsedSprite read 192 bytes beyond this asset for its walking tile bank.
+    out.paste(frame,(0,48+direction*16))
+out.save(root/'gfx/sprites/tito_xeluis.png')
+
+# The battle reference is pixel art upscaled/compressed in a JPEG. Sample logical
+# cell centers first, then fit its full silhouette inside a 56x56 trainer canvas.
+ref=Image.open(assets/'sprite_combate_tito_xeluis.jpg').convert('RGB')
+logical=ref.resize((40,40),Image.Resampling.NEAREST)
+indices=Image.new('L',(40,40),255)
+for y in range(40):
+    for x in range(40):
+        r,g,b=logical.getpixel((x,y))
+        value=255 if max(r,g,b)-min(r,g,b)<45 and min(r,g,b)>150 else 0 if r<110 else 170 if g>115 else 85
+        indices.putpixel((x,y),value)
+box=Image.eval(indices,lambda v:255-v).getbbox()
+silhouette=indices.crop(box)
+factor=min(52/silhouette.width,54/silhouette.height)
+silhouette=silhouette.resize((round(silhouette.width*factor),round(silhouette.height*factor)),Image.Resampling.NEAREST)
+# Nearest sampling preserves exact palette colors without JPEG artifacts.
+battle=Image.new('L',(56,56),255)
+battle.paste(silhouette,((56-silhouette.width)//2,56-silhouette.height))
+palette=[(255,255,255),(248,192,64),(232,88,16),(24,8,8)]
+color=Image.new('RGB',battle.size)
+for y in range(56):
+    for x in range(56):
+        color.putpixel((x,y),palette[{255:0,170:1,85:2,0:3}[battle.getpixel((x,y))]])
+color.save(root/'gfx/trainers/tito_xeluis.png')
+# Standard little-endian RGB555 palette consumed by rgbgfx and trainer loader.
+raw=bytearray()
+for r,g,b in palette:
+    n=(r>>3)|((g>>3)<<5)|((b>>3)<<10)
+    raw.extend(n.to_bytes(2,'little'))
+(root/'gfx/trainers/tito_xeluis.gbcpal').write_bytes(raw)
+print('Native overworld 16x96 and battle portrait 56x56 converted')
diff --git a/tools/export_portable_randomizer.py b/tools/export_portable_randomizer.py
new file mode 100644
index 0000000..211b7fb
--- /dev/null
+++ b/tools/export_portable_randomizer.py
@@ -0,0 +1,91 @@
+"""Export the compiled address whitelist and an offline single-file HTML tool."""
+from pathlib import Path
+import collections,hashlib,json,re,sys
+from balanced_randomizer import Randomizer,LEGENDS
+
+ROOT=Path(__file__).resolve().parents[1]
+out=Path(sys.argv[1]) if len(sys.argv)>1 else ROOT/'build/randomizer'
+out.mkdir(parents=True,exist_ok=True)
+rom=(ROOT/'pokecristal.gbc').read_bytes();sym={}
+for bank,ptr,name in re.findall(r'^([0-9a-f]+):([0-9a-f]+) (\S+)',(ROOT/'pokecristal.sym').read_text(),re.M):
+ bank,ptr=int(bank,16),int(ptr,16);sym[name]=bank*16384+ptr-16384 if bank else ptr
+site_symbols={name.rsplit('.',1)[-1]:p for name,p in sym.items() if '.__RZ' in name}
+def named(suffix):return site_symbols.get(suffix)
+rand=Randomizer(20261019)
+# Friendship/trade evolutions were changed after the original seed generator.
+# Eligibility must follow the CURRENT methods, not the archived cartridge tables.
+evos=(ROOT/'data/pokemon/evos_attacks.asm').read_text(encoding='utf8')
+normal={re.sub('[^A-Z0-9]','',mon):mon for mon in rand.species}
+for name,body in re.findall(r'^(\w+)EvosAttacks:\n(.*?)(?=^\w+EvosAttacks:|\Z)',evos,re.M|re.S):
+ parent=normal.get(name.upper())
+ if parent is None:continue # Dark Lugia is not part of the randomized species
+ for threshold,child in re.findall(r'^\s*db EVOLVE_(?:LEVEL|STAT), (\d+), (?:[^\n,]+, )?([A-Z][A-Z0-9_]+)\s*$',body,re.M):
+  if child in rand.ids:rand.parents[child]=(parent,int(threshold))
+for mon in rand.species:
+ current=mon;minimum=1
+ while current in rand.parents:
+  current,threshold=rand.parents[current];minimum=max(minimum,threshold)
+ rand.minlevel[mon]=minimum
+pools={};groups=collections.OrderedDict()
+for site in json.loads((ROOT/'data/events/portable_randomizer_sites.json').read_text(encoding='utf8')):
+ address=named(site['label'])
+ if address is None:continue # unused maps are intentionally absent from the ROM
+ address+=site['offset'];original=rand.ids[site['mon']]
+ assert rom[address]==original,(site,hex(address),rom[address],original)
+ key=site['group'];level=site['level'];kind=site['kind']
+ poolkey='starter' if kind=='starter' else f'level{level}'
+ if poolkey not in pools:
+  if kind=='starter':
+   pool=[s for s in rand.species if s not in rand.parents and s not in LEGENDS and 280<=rand.bst[s]<=340 and rand.evolutions[s]]
+  else:pool=rand.pool(level)
+  pools[poolkey]=[rand.ids[s] for s in pool]
+ assert pools[poolkey]
+ group=groups.setdefault(key,dict(key=key,pool=poolkey,kind=kind,original=original,sites=[]))
+ group['sites'].append(address)
+pools['egg']=[rand.ids[s] for s in rand.pool(5)]
+trades=[]
+for mon in rand.species:
+ candidates=[other for other in rand.species if other!=mon and rand.trade_phase[other]==rand.trade_phase[mon] and abs(rand.bst[other]-rand.bst[mon])<=60 and rand.minlevel[other]<=rand.minlevel[mon] and (other in LEGENDS)==(mon in LEGENDS)]
+ trades.append([rand.ids[x] for x in candidates] or [rand.ids[mon]])
+stats={}
+for mon in rand.species:
+ stats[rand.ids[mon]]=dict(base=rand.stats[mon],exp5={'GROWTH_MEDIUM_FAST':125,'GROWTH_MEDIUM_SLOW':135,'GROWTH_FAST':100,'GROWTH_SLOW':156}[rand.growth[mon]])
+party=sym['wPartyMon1'];stride=sym['wPartyMon2']-party
+egg=dict(offset=sym['OddEggs'],stride=stride+11,dv=sym['wPartyMon1DVs']-party,exp=sym['wPartyMon1Exp']-party,stats=sym['wPartyMon1MaxHP']-party)
+moveconst=(ROOT/'constants/move_constants.asm').read_text(encoding='utf8')
+moveids={s:i for i,s in enumerate(re.findall(r'^\s*const ([A-Z][A-Z0-9_]+)',moveconst,re.M))}
+assert moveids['STRUGGLE']==165
+manifest=dict(version=4,length=len(rom),groups=list(groups.values()),pools=pools,trades=trades,tradeOffset=sym['BalancedTradePools'],tm=sym['TMHMMoves'],eggs=egg,stats=stats,moves=[i for i in range(1,255) if i!=165],names={v:k for k,v in rand.ids.items()})
+mutable=[(a,1) for g in groups.values() for a in g['sites']]+[(manifest['tm'],50),(manifest['tradeOffset'],251*8),(0x14e,2)]
+for i in range(20):
+ address=egg['offset']+i*egg['stride']
+ mutable.extend([(address,1),(address+egg['exp'],3),(address+egg['stats'],12)])
+manifest['mutable']=mutable
+# Preview data: Spanish names and the trainer slots of the gym leaders, Elite Four, champion, Blue and Red.
+species_names=re.findall(r'^\s*(?:db|li|dname) "([^"@]+)@?"',(ROOT/'data/pokemon/names.asm').read_text(encoding='utf8'),re.M)
+move_names=re.findall(r'^\s*(?:db|li|dname) "([^"@]+)@?"',(ROOT/'data/moves/names.asm').read_text(encoding='utf8'),re.M)
+manifest['speciesNames']=species_names
+manifest['moveNames']=move_names
+LEADER_GROUPS=['Falkner','Bugsy','Whitney','Morty','Chuck','Jasmine','Pryce','Clair','Will','Koga','Bruno','Karen','Champion','LtSurge','Sabrina','Erika','Janine','Misty','Brock','Blaine','Blue','Red']
+leaders=collections.OrderedDict();current=None
+for line in (ROOT/'data/trainers/parties.asm').read_text(encoding='utf8').splitlines():
+ m=re.match(r'^(\w+)Group:',line)
+ if m:
+  current=m[1] if m[1] in LEADER_GROUPS else None;continue
+ m=re.match(r'\s*db "([^@]+)@", TRAINERTYPE',line)
+ if m and current:
+  if current not in leaders:leaders[current]={'name':m[1],'keys':[]} # extra parties of the same group (Super League) are not randomized
+  continue
+ m=re.match(r'^\.(__RZ\d+):',line)
+ if m and current:leaders[current]['keys'].append(m[1])
+manifest['leaders']=[leaders[g] for g in LEADER_GROUPS if g in leaders]
+manifest['starterKeys']=[g['key'] for g in groups.values() if g['kind']=='starter']
+masked=bytearray(rom)
+for a,n in mutable:masked[a:a+n]=bytes(n)
+manifest['immutableSHA256']=hashlib.sha256(masked).hexdigest()
+(out/'manifest.json').write_text(json.dumps(manifest,separators=(',',':')),encoding='utf8')
+js=(ROOT/'tools/portable_randomizer.js').read_text(encoding='utf8')
+template=(ROOT/'tools/portable_randomizer.html').read_text(encoding='utf8')
+html=template.replace('/*__CORE__*/',js).replace('/*__MANIFEST__*/',json.dumps(manifest,separators=(',',':')))
+(out/'Randomizador.html').write_text(html,encoding='utf8')
+print(json.dumps({'groups':len(groups),'sites':sum(len(g['sites']) for g in groups.values()),'sha256':manifest['immutableSHA256'],'html':str(out/'Randomizador.html')}))
diff --git a/tools/generate_sandbox_maps.py b/tools/generate_sandbox_maps.py
