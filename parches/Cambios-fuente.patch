+.DrawCompactFrame:
+	; Extend the existing four-move box one row upward and four tiles left.
+	; This produces one outer frame with a narrow divider at x=4.  Only the
+	; obsolete top border and the information column are cleared, so the move
+	; names already printed at x=6 remain untouched.
+	hlcoord 0, 11
+	ld [hl], '┌'
+	inc hl
+	ld a, '─'
+	ld c, 18
+.top
+	ld [hli], a
+	dec c
+	jr nz, .top
+	ld [hl], '┐'
+
+	hlcoord 1, 12
+	ld b, 5
+.clear_left
+	push bc
+	ld a, ' '
+	ld bc, 3
+	call ByteFill
+	ld de, SCREEN_WIDTH - 3
+	add hl, de
+	pop bc
+	dec b
+	jr nz, .clear_left
+
+	; Remove the old top edge of the move list.  It is now an interior row.
+	hlcoord 5, 12
+	ld a, ' '
+	ld bc, 14
+	call ByteFill
+
+	hlcoord 0, 12
+	ld b, 5
