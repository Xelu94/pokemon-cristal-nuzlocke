diff --git a/engine/events/other_protagonist.asm b/engine/events/other_protagonist.asm
new file mode 100644
index 0000000..9fcfb5f
--- /dev/null
+++ b/engine/events/other_protagonist.asm
@@ -0,0 +1,227 @@
+; The other protagonist (Gold when the player is a girl, Cristal when the player is a boy):
+; ambush battles after the rival's talk-only scenes, the final fight at the Indigo Plateau
+; and the Rattata trade at her home in New Bark Town.
+
+PUSHS
+SECTION "Other protagonist", ROMX
+
+MoveObjectToPlayerFront::
+; wScriptVar = map object index. Puts the object on the tile the player is facing.
+	ld a, [wScriptVar]
+	ld b, a
+	push bc
+	call GetFacingTileCoord
+	pop bc
+	farcall CopyDECoordsToMapObject
+	ret
+
+FindZurullo::
+; wScriptVar = 1 + the party slot of the first Rattata that carries Ulex's trainer ID, 0 if none.
+	xor a
+	ld [wScriptVar], a
+	ld [wCurPartyMon], a
+.loop
+	ld a, [wPartyCount]
+	ld b, a
+	ld a, [wCurPartyMon]
+	cp b
+	ret nc
+	ld e, a
+	ld d, 0
+	ld hl, wPartySpecies
+	add hl, de
+	ld a, [hl]
+	cp RATTATA
+	jr nz, .next
+	ld a, MON_OT_ID
+	call GetPartyParamLocation
+	ld a, [hli]
+	cp $be
+	jr nz, .next
+	ld a, [hl]
+	cp $ef
+	jr nz, .next
+	ld a, [wCurPartyMon]
+	inc a
+	ld [wScriptVar], a
+	ret
+.next
+	ld hl, wCurPartyMon
+	inc [hl]
+	jr .loop
+
+TradeZurulloForRandomMon::
+; Replaces the Zurullo found by FindZurullo with a random Pokemon of the third evolutionary
+; stage, five levels under the current level cap.
+	call FindZurullo ; the yes/no answer overwrote wScriptVar
+	ld a, [wScriptVar]
+	and a
+	ret z
+	dec a
+	ld [wCurPartyMon], a
+	xor a
+	ld [wPokemonWithdrawDepositParameter], a
+	farcall RemoveMonFromPartyOrBox
+.pick
+	call Random
+	and a
+	jr z, .pick
+	cp CELEBI + 1
+	jr nc, .pick
+	ld [wCurPartySpecies], a
+	ld b, a
+	push bc
+	callfar GetPreEvolution
+	pop bc
+	ld a, [wCurPartySpecies]
+	cp b
+	jr z, .pick ; no pre-evolution: first stage
+	ld c, a
+	push bc
+	callfar GetPreEvolution
+	pop bc
+	ld a, [wCurPartySpecies]
+	cp c
+	jr z, .pick ; only one pre-evolution: second stage
+	ld a, b
+	ld [wCurPartySpecies], a
+	farcall GetCurrentLevelCap
+	ld a, b
+	sub 5
+	jr c, .minimum
+	cp 5
+	jr nc, .level_ok
+.minimum
+	ld a, 5
+.level_ok
+	ld [wCurPartyLevel], a
+	xor a
+	ld [wMonType], a
+	ld [wBattleMode], a
+	predef TryAddMonToParty
+	ret
+
+OtherAmbushIntroText1::
+	text "¿Que te pensabas,"
+	line "wachín? ¿Que te"
+	cont "ibas a librar de"
+	cont "pelear?"
+
+	para "¡Prepara bien ese"
+	line "culito!"
+	done
+
+OtherAmbushIntroText2::
+	text "¡Eh, wachín!"
+	line "¿Creías que ya te"
+	cont "habías librado"
+	cont "de mí?"
+
+	para "¡Ese culito no se"
+	line "libra otra vez!"
+	done
+
+OtherAmbushIntroText3::
+	text "¡Otra vez yo,"
+	line "wachín! ¿Pensabas"
+	cont "que no te iba a"
+	cont "encontrar aquí?"
+
+	para "¡Prepárate!"
+	done
+
+OtherAmbushWinText::
+	text "¡Ugh! ¡Me has"
+	line "ganado!"
+	done
+
+OtherAmbushLossText::
+	text "¡Ja! ¡Te he"
+	line "ganado, wachín!"
+	done
+
+OtherAmbushAfterText::
+	text "Bah… Toma, que"
+	line "te curo los"
+	cont "#MON."
+
+	para "Y llévate esto."
+	line "¡Hasta la vista,"
+	cont "wachín!"
+	done
+
+OtherFinalIntroText::
+	text "Prepárate para"
+	line "nuestro último y"
+	cont "más épico combate."
+	done
+
+OtherFinalWinText::
+	text "Bien hecho, me has"
+	line "dado para el pelo."
+	done
+
+OtherFinalLossText::
+	text "¡Ja! ¡Te he"
+	line "ganado!"
+	done
+
+OtherFinalAfterText1::
+	text "Bueno, parece que"
+	line "no tengo lo que"
+	cont "hace falta para"
+	cont "enfrentarme a la"
+	cont "LIGA."
+
+	para "Lo dejo aquí."
+	line "Voy a dedicarme a"
+	cont "coleccionar"
+	cont "RATTATA que se"
+	cont "llamen ZURULLO."
+	done
+
+OtherFinalAfterText2::
+	text "Toma, un huevo de"
+	line "recuerdo."
+	cont "¡Cuídalo mucho!"
+	done
+
+OtherHomeText::
+	text "¡Hola, wachín!"
+	line "Aquí estoy con mi"
+	cont "RATTATA, ZURULLO."
+
+	para "Si me traes un"
+	line "RATTATA de los que"
+	cont "da ULEX, te lo"
+	cont "cambio por un"
+	cont "#MON de tercera"
+	cont "etapa evolutiva."
+	done
+
+OtherHomeAskText::
+	text "¿Quieres cambiar a"
+	line "tu ZURULLO?"
+	done
+
+OtherHomeNoZurulloText::
+	text "No tienes ningún"
+	line "ZURULLO de ULEX."
+	done
+
+OtherHomeDoneText::
+	text "¡Trato hecho!"
+	line "¡Cuídalo mucho!"
+	done
+
+OtherHomeDeclinedText::
+	text "Vale, cuando"
+	line "quieras."
+	done
+
+OtherHomeDoneAgainText::
+	text "Ya tengo ZURULLO."
+	line "Si me traes otro,"
+	cont "te lo cambio."
+	done
+POPS
