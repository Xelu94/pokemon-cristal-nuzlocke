diff --git a/engine/pokemon/nuzlocke.asm b/engine/pokemon/nuzlocke.asm
new file mode 100644
index 0000000..1daba32
--- /dev/null
+++ b/engine/pokemon/nuzlocke.asm
@@ -0,0 +1,329 @@
+; This hack always uses permanent death and one encounter per landmark.
+; Gifts, eggs and NPC trades do not begin wild battles and are exempt.
+
+NuzlockeCheckPartyMonDead:
+	ld a, MON_CAUGHTLOCATION
+	call GetPartyParamLocation
+	bit NUZLOCKE_DEAD_F, [hl]
+	ret
+
+NuzlockeMarkPartyMonDead:
+	ld hl, wEventFlags + EVENT_EXHIBITION_BATTLE / 8
+	bit EVENT_EXHIBITION_BATTLE % 8, [hl]
+	ret nz ; exhibition battles: fainted but not dead
+	ld a, MON_CAUGHTLOCATION
+	call GetPartyParamLocation
+	set NUZLOCKE_DEAD_F, [hl]
+	ld a, MON_HP
+	call GetPartyParamLocation
+	xor a
+	ld [hli], a
+	ld [hl], a
+	ret
+
+NuzlockeMarkFaintedParty:
+; Defensive sweep catches simultaneous KOs, Perish Song and battle exits.
+	ld a, [wCurPartyMon]
+	push af
+	xor a
+	ld [wCurPartyMon], a
+.loop
+	ld a, [wPartyCount]
+	ld b, a
+	ld a, [wCurPartyMon]
+	cp b
+	jr nc, .done
+	ld e, a
+	ld d, 0
+	ld hl, wPartySpecies
+	add hl, de
+	ld a, [hl]
+	cp EGG
+	jr z, .next
+	ld a, MON_HP
+	call GetPartyParamLocation
+	ld a, [hli]
+	or [hl]
+	call z, NuzlockeMarkPartyMonDead
+.next
+	ld hl, wCurPartyMon
+	inc [hl]
+	jr .loop
+.done
+	pop af
+	ld [wCurPartyMon], a
+	ret
+
+NuzlockeBeginWildBattle:
+; Consuming the area's bit at encounter start makes fleeing or a KO count.
+	xor a
+	ld [wNuzlockeCaptureAllowed], a
+	ld a, [wNuzlockeRunEnded]
+	and a
+	ret nz
+	ld a, [wBattleType]
+	cp BATTLETYPE_TUTORIAL
+	jr z, .allowed
+	cp BATTLETYPE_ROAMING
+	jr z, .allowed
+	ld a, [wBattleScriptFlags]
+	bit 7, a ; explicit loadwildmon script, not grass/fishing/tree
+	jr nz, .allowed
+	ld a, [wLinkMode]
+	and a
+	ret nz
+	ld a, [wNumBalls]
+	and a
+	ret z ; grace before the player has any usable Balls
+	ld a, [wMapGroup]
+	ld b, a
+	ld a, [wMapNumber]
+	ld c, a
+	call GetWorldMapLocation
+	cp NUM_LANDMARKS
+	ret nc
+	ld c, a
+	and 7
+	ld e, a
+	ld d, 0
+	ld hl, .Bits
+	add hl, de
+	ld b, [hl]
+	ld a, c
+	srl a
+	srl a
+	srl a
+	ld e, a
+	ld hl, wNuzlockeEncounterAreas
+	add hl, de
+	ld a, [hl]
+	and b
+	ret nz
+	ld a, [hl]
+	or b
+	ld [hl], a
+.allowed
+	ld a, 1
+	ld [wNuzlockeCaptureAllowed], a
+	ret
+.Bits
+	db 1, 2, 4, 8, 16, 32, 64, 128
+
+NuzlockeCaptureBlockedMessage:
+	ld hl, .Text
+	call PrintText
+	ld a, 2
+	ld [wItemEffectSucceeded], a
+	ret
+.Text
+	text "NUZLOCKE: ya has"
+	line "tenido tu primer"
+	cont "encuentro aqui."
+	prompt
+
+NuzlockeDeadMonMessage:
+	ld hl, .Text
+	call PrintText
+	ret
+.Text
+	text "Este #MON ha"
+	line "muerto. No puede"
+	cont "volver a luchar."
+	prompt
+
+NuzlockeTowerLivingText:
+	text "Se requieren tres"
+	line "#MON vivos."
+	cont "Sin HUEVOS ni"
+	cont "#MON muertos."
+	prompt
+
+NuzlockeEvaluateRun:
+; Called on whiteout. A living reserve (including an unhatched egg) permits
+; recovery; with no party, PC or daycare survivors the run ends permanently.
+	ld a, [wNuzlockeRunEnded]
+	and a
+	jp nz, .ended
+	ld a, [wPartyCount]
+	ld b, a
+	ld hl, wPartyMons
+	call .ScanParty
+	jp c, .alive
+	ld a, [wDayCareMan]
+	bit 0, a
+	jr z, .lady
+	ld hl, wBreedMon1
+	ld b, 1
+	call .ScanMons
+	jp c, .alive
+.lady
+	ld a, [wDayCareLady]
+	bit 0, a
+	jr z, .active_box
+	ld hl, wBreedMon2
+	ld b, 1
+	call .ScanMons
+	jp c, .alive
+.active_box
+	ld a, BANK(sBox)
+	call OpenSRAM
+	ld hl, sBox
+	call .ScanBox
+	call CloseSRAM
+	jp c, .alive
+	ld c, 0
+.boxes
+	ld a, [wCurBox]
+	and $7f
+	cp c
+	jr z, .next_box ; current saved copy can be stale; active box is authoritative
+	push bc
+	ld a, c
+	ld hl, .BoxAddresses
+	ld bc, 3
+	call AddNTimes
+	ld a, [hli]
+	push af
+	ld a, [hli]
+	ld h, [hl]
+	ld l, a
+	pop af
+	call OpenSRAM
+	call .ScanBox
+	call CloseSRAM
+	pop bc
+	jr c, .alive
+.next_box
+	inc c
+	ld a, c
+	cp NUM_BOXES
+	jr c, .boxes
+.ended
+	ld a, 1
+	ld [wNuzlockeRunEnded], a
+	ld [wScriptVar], a
+	ret
+.alive
+	xor a
+	ld [wScriptVar], a
+	ret
+
+.ScanBox
+	ld a, [hl]
+	cp MONS_PER_BOX + 1
+	jr nc, .none ; an uninitialized SRAM box is not a living reserve
+	ld b, a
+	ld de, 1 + MONS_PER_BOX + 1
+	add hl, de
+.ScanMons
+	ld a, b
+	and a
+	jr z, .none
+.mon_loop
+	push hl
+	ld a, [hl]
+	and a
+	jr z, .skip_mon
+	cp NUM_POKEMON + 1
+	jr nc, .skip_mon
+	ld de, MON_CAUGHTLOCATION
+	add hl, de
+	bit NUZLOCKE_DEAD_F, [hl]
+	pop hl
+	jr z, .survivor
+	jr .advance
+.skip_mon
+	pop hl
+.advance
+	ld de, BOXMON_STRUCT_LENGTH
+	add hl, de
+	dec b
+	jr nz, .mon_loop
+.none
+	and a
+	ret
+.survivor
+	scf
+	ret
+
+.ScanParty
+	ld a, b
+	and a
+	jr z, .none
+.party_loop
+	push hl
+	ld de, MON_CAUGHTLOCATION
+	add hl, de
+	bit NUZLOCKE_DEAD_F, [hl]
+	pop hl
+	jr z, .survivor
+	ld de, PARTYMON_STRUCT_LENGTH
+	add hl, de
+	dec b
+	jr nz, .party_loop
+	jr .none
+
+.BoxAddresses
+for n, 1, NUM_BOXES + 1
+	db BANK(sBox{d:n})
+	dw sBox{d:n}
+endr
+
+NuzlockeCollectDeathMask:
+; Battle Tower and link battles reload PokemonData after battle. Preserve the
+; six death bits outside that region and reapply them to the restored party.
+	ld a, [wCurPartyMon]
+	push af
+	xor a
+	ld [wCurPartyMon], a
+	ld [wNuzlockeCaptureAllowed], a
+.loop
+	ld a, [wPartyCount]
+	ld b, a
+	ld a, [wCurPartyMon]
+	cp b
+	jr nc, .done
+	call NuzlockeCheckPartyMonDead
+	jr z, .next
+	ld a, [wCurPartyMon]
+	ld e, a
+	ld d, 0
+	ld hl, NuzlockeBeginWildBattle.Bits
+	add hl, de
+	ld a, [wNuzlockeCaptureAllowed]
+	or [hl]
+	ld [wNuzlockeCaptureAllowed], a
+.next
+	ld hl, wCurPartyMon
+	inc [hl]
+	jr .loop
+.done
+	pop af
+	ld [wCurPartyMon], a
+	ret
+
+NuzlockeApplyDeathMask:
+	ld a, [wCurPartyMon]
+	push af
+	xor a
+	ld [wCurPartyMon], a
+.loop
+	ld a, [wPartyCount]
+	ld b, a
+	ld a, [wCurPartyMon]
+	cp b
+	jr nc, .done
+	ld e, a
+	ld d, 0
+	ld hl, NuzlockeBeginWildBattle.Bits
+	add hl, de
+	ld a, [wNuzlockeCaptureAllowed]
+	and [hl]
+	call nz, NuzlockeMarkPartyMonDead
+	ld hl, wCurPartyMon
+	inc [hl]
+	jr .loop
+.done
+	pop af
+	ld [wCurPartyMon], a
+	ret
