new file mode 100644
index 0000000..74b5e2f
--- /dev/null
+++ b/engine/debug/nuzlocke_sandbox.asm
@@ -0,0 +1,374 @@
+SECTION "Nuzlocke sandbox tools", ROMX
+
+SandboxMenu::
+	; StartMenu entered via FadeToMenu, which leaves all colors white. Establish
+	; a real text-menu layout before drawing any tool or result dialogs.
+	call ClearBGPalettes
+	call ClearScreen
+	ld b, SCGB_DIPLOMA
+	call GetSGBLayout
+	call SetDefaultBGPAndOBP
+	xor a
+	ld [wSandboxWarpPending], a
+	ld [wSandboxUseGeneric], a
+.loop
+	call ClearTilemap
+	call ClearSprites
+	ld hl, .MenuHeader
+	call LoadMenuHeader
+	call VerticalMenu
+	call ExitMenu
+	ret c
+	ld a, [wMenuCursorY]
+	cp 1
+	jp z, SandboxChooseDestination
+	cp 2
+	jr z, .stage
+	cp 3
+	jr z, .league
+	cp 4
+	jr z, .team
+	cp 5
+	jr z, .reset
+	cp 6
+	jr z, .items
+	cp 7
+	jr z, .options
+	ret
+.stage
+	call SandboxChooseStage
+	jr .loop
+.league
+	call SandboxToggleLeagueRed
+	jr .loop
+.team
+	call SandboxPrepareTeam
+	jr .loop
+.reset
+	call SandboxResetChallenges
+	jr .loop
+.items
+	call SandboxGiveItems
+	jr .loop
+.options
+	farcall Option
+	jr .loop
+.MenuHeader
+	db MENU_BACKUP_TILES
+	menu_coords 0, 0, 19, 17
+	dw .MenuData
+	db 1
+.MenuData
+	db STATICMENU_CURSOR
+	db 8
+	db "VIAJAR@"
+	db "SUBIR MEDALLAS@"
+	db "LIGA / ROJO@"
+	db "EQUIPO DE PRUEBA@"
+	db "REINICIAR RETOS@"
+	db "OBJETOS@"
+	db "OPCIONES@"
+	db "SALIR@"
+
+SandboxChooseStage::
+	call ClearTilemap
+	ld hl, .Header
+	call LoadMenuHeader
+	xor a
+	ld [wMenuScrollPosition], a
+	ld [wWhichIndexSet], a
+	inc a
+	ld [wMenuCursorPosition], a
+	call InitScrollingMenu
+	call ScrollingMenu
+	call ExitMenu
+	ld a, [wMenuJoypad]
+	cp PAD_B
+	ret z
+	ld a, [wMenuSelection]
+	cp -1
+	ret z
+	ld [wSandboxStage], a
+	call SandboxApplyStage
+	ret
+.Header
+	db MENU_BACKUP_TILES
+	menu_coords 1, 1, 18, 16
+	dw .Data
+	db 1
+.Data
+	db SCROLLINGMENU_DISPLAY_ARROWS
+	db 8, 0
+	db SCROLLINGMENU_ITEMS_NORMAL
+	dba .List
+	dba .Print
+	dba NULL
+	dba NULL
+.List
+	db 17
+	for n, 0, 17
+		db n
+	endr
+	db -1
+.Print
+	push de
+	ld a, [wMenuSelection]
+	ld hl, .Names
+	call GetNthString
+	ld d, h
+	ld e, l
+	pop hl
+	jp PlaceString
+.Names
+	db "0 MEDALLAS@"
+	db "1 MEDALLA@"
+	db "2 MEDALLAS@"
+	db "3 MEDALLAS@"
+	db "4 MEDALLAS@"
+	db "5 MEDALLAS@"
+	db "6 MEDALLAS@"
+	db "7 MEDALLAS@"
+	db "8 MEDALLAS@"
+	db "9 MEDALLAS@"
+	db "10 MEDALLAS@"
+	db "11 MEDALLAS@"
+	db "12 MEDALLAS@"
+	db "13 MEDALLAS@"
+	db "14 MEDALLAS@"
+	db "15 MEDALLAS@"
+	db "16 MEDALLAS@"
+
+SandboxAdvanceStage::
+	; Compatibility helper for automated tools: advance one stage.
+	ld hl, wJohtoBadges
+	ld b, 2
+	call CountSetBits
+	ld a, [wNumSetBits]
+	inc a
+	cp 17
+	jr c, .stage
+	xor a
+.stage
+	ld [wSandboxStage], a
+	; fallthrough
+SandboxApplyStage::
+	ld a, [wSandboxStage]
+	ld hl, .JohtoMasks
+	ld e, a
+	ld d, 0
+	add hl, de
+	ld a, [hl]
+	ld [wJohtoBadges], a
+	ld hl, .KantoMasks
+	add hl, de
+	ld a, [hl]
+	ld [wKantoBadges], a
+	ld hl, wStatusFlags
+	res STATUSFLAGS_HALL_OF_FAME_F, [hl]
+	ld a, [wSandboxStage]
+	cp 9
+	jr c, .no_league
+	set STATUSFLAGS_HALL_OF_FAME_F, [hl]
+.no_league
+	ld de, EVENT_BEAT_RED_PERMANENT
+	ld b, RESET_FLAG
+	call EventFlagAction
+	farcall GetCurrentLevelCap
+	ld a, b
+	ld [wSandboxCap], a
+	ld hl, .StageText
+	jp PrintText
+.JohtoMasks
+	db 0, 1, 3, 7, 15, 47, 63, 127, 255
+	rept 8
+		db 255
+	endr
+.KantoMasks
+	ds 9, 0
+	db 1 << THUNDERBADGE
+	db (1 << THUNDERBADGE) | (1 << MARSHBADGE)
+	db (1 << THUNDERBADGE) | (1 << MARSHBADGE) | (1 << RAINBOWBADGE)
+	db (1 << THUNDERBADGE) | (1 << MARSHBADGE) | (1 << RAINBOWBADGE) | (1 << SOULBADGE)
+	db 255 ^ (1 << BOULDERBADGE) ^ (1 << VOLCANOBADGE) ^ (1 << EARTHBADGE)
+	db 255 ^ (1 << VOLCANOBADGE) ^ (1 << EARTHBADGE)
+	db 255 ^ (1 << EARTHBADGE)
+	db 255
+.StageText
+	text "SANDBOX"
+	line "Medallas: @"
+	text_decimal wSandboxStage, 1, 2
+	text_start
+	para "Límite: @"
+	text_decimal wSandboxCap, 1, 3
+	text_start
+	done
+
+SandboxToggleLeagueRed::
+	ld a, [wJohtoBadges]
+	cp 255
+	jr nz, .need_badges
+	ld a, [wKantoBadges]
+	cp 255
+	jr z, .red
+	ld hl, wStatusFlags
+	ld a, [hl]
+	xor 1 << STATUSFLAGS_HALL_OF_FAME_F
+	ld [hl], a
+	ld hl, .LeagueText
+	jp PrintText
+.red
+	ld de, EVENT_BEAT_RED_PERMANENT
+	ld b, CHECK_FLAG
+	call EventFlagAction
+	ld a, c
+	and a
+	ld b, SET_FLAG
+	jr z, .set_red
+	ld b, RESET_FLAG
+.set_red
+	ld de, EVENT_BEAT_RED_PERMANENT
+	call EventFlagAction
+	ld hl, .RedText
+	jp PrintText
+.need_badges
+	ld hl, .NeedBadgesText
+	jp PrintText
+.LeagueText
+	text "Victoria de LIGA"
+	line "activada/cambiada."
+	done
+.RedText
+	text "Victoria de ROJO"
+	line "activada/cambiada."
+	done
+.NeedBadgesText
+	text "Primero consigue"
+	line "8 medallas aquí."
+	done
+
+SandboxPrepareTeam::
+	xor a
+	ld [wPartyCount], a
+	ld [wBattleMode], a
+	ld [wMonType], a
+	ld [wNuzlockeRunEnded], a
+	ld a, -1
+	ld [wPartySpecies], a
+	ld hl, .Species
+	ld b, 3
+.loop
+	push bc
+	ld a, [hli]
+	push hl
+	ld [wCurPartySpecies], a
+	farcall GetCurrentLevelCap
+	dec b
+	ld a, b
+	ld [wCurPartyLevel], a
+	predef TryAddMonToParty
+	ld a, [wPartyCount]
+	dec a
+	ld [wCurPartyMon], a
+	ld a, MON_DVS
+	call GetPartyParamLocation
+	ld a, $2a
+	ld [hli], a
+	ld [hl], $aa
+	ld a, MON_MOVES
+	call GetPartyParamLocation
+	ld d, h
+	ld e, l
+	ld hl, .Moves
+	ld bc, NUM_MOVES
+	call CopyBytes
+	ld a, MON_PP
+	call GetPartyParamLocation
+	ld a, 40
+	ld b, NUM_MOVES
+.pp
+	ld [hli], a
+	dec b
+	jr nz, .pp
+	ld a, MON_ITEM
+	call GetPartyParamLocation
+	ld [hl], FOCUS_SASH
+	farcall ComputeNPCTrademonStats
+	farcall HealPartyMon
+	pop hl
+	pop bc
+	dec b
+	jr nz, .loop
+	ld hl, .Text
+	jp PrintText
+.Species
+	db BAYLEEF, HOUNDOOM, TOGETIC
+.Moves
+	db ICY_WIND, HIDDEN_POWER, MOONBLAST, SURF
+.Text
+	text "Equipo de prueba:"
+	line "tres SHINY al"
+	cont "límite menos 1."
+	para "Viento Hielo y"
+	line "Poder Oculto,"
+	cont "con BANDA FOCUS."
+	done
+
+SandboxResetChallenges::
+	ld hl, wEventFlags + EVENT_TITO_TRADE_BASE / 8
+	ld bc, 21
+	xor a
+	call ByteFill
+	ld hl, wNuzlockeEncounterAreas
+	ld bc, (NUM_LANDMARKS + 7) / 8 + 1
+	xor a
+	call ByteFill
+	ld hl, .Text
+	jp PrintText
+.Text
+	text "Retos reiniciados."
+	line "Sal de la zona"
+	cont "y vuelve a entrar."
+	done
+
+SandboxGiveItems::
+	ld hl, .Items
+.loop
+	ld a, [hli]
+	and a
+	jr z, .done
+	push hl
+	ld [wCurItem], a
+	ld a, 10
+	ld [wItemQuantityChange], a
+	ld hl, wNumItems
+	call ReceiveItem
+	pop hl
+	jr .loop
+.done
+	ld a, 7
+	ld [wSandboxStage], a
+.tms
+	farcall ReceiveRandomTM
+	ld hl, wSandboxStage
+	dec [hl]
+	jr nz, .tms
+	ld hl, .Text
+	jp PrintText
+.Items
+	db REPEL, SUPER_REPEL, MAX_REPEL, FOCUS_SASH, POTION, FULL_RESTORE, 0
+.Text
+	text "Objetos añadidos:"
+	line "repelentes, curas,"
+	cont "BANDA FOCUS y MTs."
+	done
+
+INCLUDE "engine/debug/sandbox_destinations.asm"
+INCLUDE "engine/debug/sandbox_any_map.asm"
+
+; Sandbox menus run outside Ulex battles; this unused tail is shared scratch.
+SECTION UNION "Unused Map Buffer", WRAM0
+	ds 1
+wSandboxWarpPending:: db
+wSandboxDestination:: db
+wSandboxStage:: db
+wSandboxCap:: db
