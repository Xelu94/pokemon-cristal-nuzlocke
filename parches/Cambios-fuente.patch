+	checkevent EVENT_SUPER_BEAT_AZUL
+	iffalse .Closed
+	changeblock 4, 2, $16 ; open door
+.Closed:
+	endcallback
+
+SuperAzulScript:
+	faceplayer
+	opentext
+	checkevent EVENT_SUPER_BEAT_AZUL
+	iftrue .Beaten
+	writetext SuperAzulBeforeText
+	waitbutton
+	closetext
+	setevent EVENT_EXHIBITION_BATTLE
+	winlosstext SuperAzulBeatenText, SuperAzulLossText
+	loadtrainer BLUE, BLUE_SUPER
+	loadvar VAR_BATTLETYPE, BATTLETYPE_CANLOSE
+	startbattle
+	reloadmap
+	readmem wBattleResult
+	ifequal LOSE, .Lost
+	clearevent EVENT_EXHIBITION_BATTLE
+	setevent EVENT_SUPER_BEAT_AZUL
+	opentext
+	writetext SuperAzulAfterText
+	waitbutton
+	closetext
