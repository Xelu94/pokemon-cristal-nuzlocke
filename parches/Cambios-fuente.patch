+	text "Eyyyy siiiii, has"
+	line "llegado hasta"
+	cont "aquí, wachin."
+
+	para "Soy el campeón de"
+	line "la SUPERLIGA y"
+	cont "estos son mis"
+	cont "#MON de leyenda"
+
+	para "¡Vamoh a darle!"
+	done
+
+SuperTitoBeatenText:
+	text "Ostias… me has"
+	line "dado para el pelo"
+	cont "otra vez."
+
+	para "El campeón eres"
+	line "tú."
+	done
+
+SuperTitoLossText:
+	text "¡Vamoh, wachin!"
+	line "Te falta calle."
+	done
+
+SuperTitoAfterText:
+	text "Mi favorito es"
+	line "este CHARIZARD"
+	cont "SHINY, y hoy es"
+	cont "tuyo."
+	done
+
+SuperTitoLetterText:
+	text "Lleva una carta:"
+
+	para "«Eres el puto amo,"
+	line "has conseguido"
+	cont "completar el juego"
+	cont "y sobre todo este"
+	cont "desafío, que es el"
+	cont "más jodido de"
+	cont "todos. ¡Eres la"
+	cont "cabra!»"
+	done
+
+SuperTitoFarewellText:
+	text "Gracias por el"
+	line "combate, wachin."
+	cont "Nos vemos en el"
+	cont "CENTRO #MON."
+	done
+
