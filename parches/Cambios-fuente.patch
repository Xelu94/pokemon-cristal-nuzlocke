diff --git a/engine/pokemon/v2_balance.asm b/engine/pokemon/v2_balance.asm
new file mode 100644
index 0000000..d63687a
--- /dev/null
+++ b/engine/pokemon/v2_balance.asm
@@ -0,0 +1,373 @@
+; Shared by battle EXP, Rare Candy, Day-Care and TITO XELUIS.
+; Output: B = current cap. Preserves C, DE and HL. The cap follows the
+; first undefeated leader in progression order, including optional gyms.
+GetCurrentLevelCap::
+	push hl
+	ld hl, V3JohtoCaps
+	ld a, [wJohtoBadges]
+	ld b, a
+.johto
+	ld a, [hli]
+	and a
+	jr z, .league
+	and b
+	jr z, .found
+	inc hl
+	jr .johto
+.league
+	ld a, [wStatusFlags]
+	bit STATUSFLAGS_HALL_OF_FAME_F, a
+	ld b, 65
+	jr z, .done
+	ld hl, V3KantoCaps
+	ld a, [wKantoBadges]
+	ld b, a
+.kanto
+	ld a, [hli]
+	and a
+	jr z, .all_badges
+	and b
+	jr z, .found
+	inc hl
+	jr .kanto
+.found
+	ld b, [hl]
+	jr .done
+.all_badges
+	ld b, 95
+	ld a, [wEventFlags + EVENT_BEAT_RED_PERMANENT / 8]
+	bit EVENT_BEAT_RED_PERMANENT % 8, a
+	jr z, .done
+	ld b, MAX_LEVEL
+.done
+	ld a, b
+	pop hl
+	ret
+
+ChooseRandomLevelMove::
+; Preserve DE/HL/C. Return an unknown valid move in B (far calls clobber A).
+; Original EvosAttacks tables remain untouched for Tito's move reminder.
+	push bc
+	push de
+	push hl
+.sample
+	call Random
+	and a
+	jr z, .sample
+	cp NUM_ATTACKS + 1
+	jr nc, .sample
+	cp STRUGGLE
+	jr z, .sample
+	ld d, a
+	ld hl, wPartyMon1Moves
+	ld bc, PARTYMON_STRUCT_LENGTH
+	ld a, [wCurPartyMon]
+	call AddNTimes
+	ld b, NUM_MOVES
+.known
+	ld a, [hli]
+	cp d
+	jr z, .sample
+	dec b
+	jr nz, .known
+	ld a, d
+	pop hl
+	pop de
+	pop bc
+	ld b, a
+	ret
+ChooseRandomMoveAtDE::
+; Day-Care withdrawal: DE points to the four known moves. Return B = move.
+	push bc
+	push de
+	push hl
+.sample
+	call Random
+	and a
+	jr z, .sample
+	cp NUM_ATTACKS + 1
+	jr nc, .sample
+	cp STRUGGLE
+	jr z, .sample
+	ld c, a
+	ld h, d
+	ld l, e
+	ld b, NUM_MOVES
+.known
+	ld a, [hli]
+	cp c
+	jr z, .sample
+	dec b
+	jr nz, .known
+	ld a, c
+	pop hl
+	pop de
+	pop bc
+	ld b, a
+	ret
+
+V3JohtoCaps:
+	db 1 << ZEPHYRBADGE, 19
+	db 1 << HIVEBADGE, 24
+	db 1 << PLAINBADGE, 29
+	db 1 << FOGBADGE, 35
+	db 1 << STORMBADGE, 40
+	db 1 << MINERALBADGE, 44
+	db 1 << GLACIERBADGE, 48
+	db 1 << RISINGBADGE, 53
+	db 0
+V3KantoCaps:
+	db 1 << THUNDERBADGE, 67
+	db 1 << MARSHBADGE, 70
+	db 1 << RAINBOWBADGE, 73
+	db 1 << SOULBADGE, 75
+	db 1 << CASCADEBADGE, 77
+	db 1 << BOULDERBADGE, 80
+	db 1 << VOLCANOBADGE, 83
+	db 1 << EARTHBADGE, 85
+	db 0
+
+; Generate four distinct random moves at DE without altering the species'
+; original learnset. Slot 1 always inflicts direct, repeatable damage and
+; never requires sleeping, a sleeping target, or sacrificing the user.
+; Preserves BC, DE and HL. Used when a Pokemon is first generated only.
+RandomizeFourMoves::
+	push bc
+	push de
+	push hl
+	ld b, 0
+.sample
+	call Random
+	and a
+	jr z, .sample
+	cp NUM_ATTACKS + 1
+	jr nc, .sample
+	cp STRUGGLE
+	jr z, .sample
+	ld c, a
+	ld a, b
+	and a
+	jr nz, .check_repeat
+	ld a, c
+	cp SELFDESTRUCT
+	jr z, .sample
+	cp EXPLOSION
+	jr z, .sample
+	cp DREAM_EATER
+	jr z, .sample
+	cp SNORE
+	jr z, .sample
+	cp COUNTER
+	jr z, .sample
+	cp MIRROR_COAT
+	jr z, .sample
+	cp GUILLOTINE
+	jr z, .sample
+	cp HORN_DRILL
+	jr z, .sample
+	cp FISSURE
+	jr z, .sample
+	cp BEAT_UP
+	jr z, .sample
+	dec a
+	ld hl, Moves + MOVE_POWER
+	push bc
+	ld bc, MOVE_LENGTH
+	call AddNTimes
+	ld a, BANK(Moves)
+	call GetFarByte
+	pop bc
+	and a
+	jr z, .sample
+.check_repeat
+	push bc
+	ld h, d
+	ld l, e
+	ld a, b
+	and a
+	jr z, .unique
+.repeat_loop
+	ld a, [hli]
+	cp c
+	jr z, .duplicate
+	dec b
+	jr nz, .repeat_loop
+.unique
+	pop bc
+	ld h, d
+	ld l, e
+	ld a, b
+	add l
+	ld l, a
+	jr nc, .store
+	inc h
+.store
+	ld [hl], c
+	inc b
+	ld a, b
+	cp NUM_MOVES
+	jr nz, .sample
+	pop hl
+	pop de
+	pop bc
+	ret
+.duplicate
+	pop bc
+	jr .sample
+
+; Apply random moves and useful held items after reading all trainer party
+; formats, so preset trainer moves cannot overwrite the generated ones.
+RandomizeTrainerParty::
+	ld a, [wOTPartyCount]
+	and a
+	ret z
+	ld b, a
+	ld hl, wOTPartyMon1
+.party
+	push bc
+	push hl
+	call RandomizeTrainerMon
+	pop hl
+	ld bc, PARTYMON_STRUCT_LENGTH
+	add hl, bc
+	pop bc
+	dec b
+	jr nz, .party
+	ret
+
+; HL = party-format mon. Also usable with the Battle Tower's mon structures.
+RandomizeTrainerMon::
+	push hl
+	ld de, MON_MOVES
+	add hl, de
+	ld d, h
+	ld e, l
+	call RandomizeFourMoves
+	ld h, d
+	ld l, e
+	push hl
+	ld de, MON_PP - MON_MOVES
+	add hl, de
+	ld d, h
+	ld e, l
+	pop hl
+	predef FillPP
+	pop hl
+	push hl
+	inc hl
+	inc hl
+	ld a, [hl] ; first move is always a usable damaging move
+	dec a
+	ld hl, Moves + MOVE_TYPE
+	ld bc, MOVE_LENGTH
+	call AddNTimes
+	ld a, BANK(Moves)
+	call GetFarByte
+	and TYPE_MASK
+	ld c, a
+	call Random
+	and 1
+	jr nz, .utility
+	ld b, 0
+	ld hl, .TypeItems
+	add hl, bc
+	ld a, [hl]
+	jr .item
+.utility
+	call Random
+	and 7
+	ld c, a
+	ld b, 0
+	ld hl, .UtilityItems
+	add hl, bc
+	ld a, [hl]
+.item
+	pop hl
+	inc hl
+	ld [hl], a
+	ret
+.TypeItems
+	db PINK_BOW, BLACKBELT_I, SHARP_BEAK, POISON_BARB
+	db SOFT_SAND, HARD_STONE, BERRY, SILVERPOWDER
+	db SPELL_TAG, METAL_COAT
+	rept FIRE - 10
+		db LEFTOVERS
+	endr
+	db CHARCOAL, MYSTIC_WATER, MIRACLE_SEED, MAGNET
+	db TWISTEDSPOON, NEVERMELTICE, DRAGON_SCALE, BLACKGLASSES
+	db LEFTOVERS ; FAIRY (type28 in v2)
+.UtilityItems
+	db BERRY, GOLD_BERRY, LEFTOVERS, MIRACLEBERRY
+	db BITTER_BERRY, BERRY_JUICE, QUICK_CLAW, FOCUS_BAND
+
+; C = original level, D = level calculated from accumulated Day-Care EXP.
+; Clamp growth at the cap without lowering preexisting over-cap Pokemon.
+ClampDayCareLevel::
+	call GetCurrentLevelCap
+	ld a, b
+	cp c
+	jr nc, .have_cap
+	ld b, c
+.have_cap
+	ld a, d
+	cp b
+	ret c
+	ld d, b
+	ret
+
+; HL points to the Day-Care mon. Stops hidden EXP accumulating above cap.
+; Preserves all normal registers; hProduct is scratch as in standard EXP.
+GiveCappedDayCareExp::
+	push af
+	push bc
+	push de
+	push hl
+	ld a, [wCurSpecies]
+	push af
+	ld a, [hl]
+	ld [wCurSpecies], a
+	push hl
+	call GetBaseData
+	call GetCurrentLevelCap
+	ld d, b
+	callfar CalcExpAtLevel
+	pop hl
+	ld de, MON_EXP
+	add hl, de
+	ldh a, [hProduct + 1]
+	ld b, a
+	ld a, [hli]
+	cp b
+	jr c, .increment
+	jr nz, .finish
+	ldh a, [hProduct + 2]
+	ld b, a
+	ld a, [hli]
+	cp b
+	jr c, .increment_low
+	jr nz, .finish
+	ldh a, [hProduct + 3]
+	ld b, a
+	ld a, [hl]
+	cp b
+	jr nc, .finish
+	jr .increment_lowest
+.increment
+	inc hl
+.increment_low
+.increment_lowest
+	inc [hl]
+	jr nz, .finish
+	dec hl
+	inc [hl]
+	jr nz, .finish
+	dec hl
+	inc [hl]
+.finish
+	pop af
+	ld [wCurSpecies], a
+	pop hl
+	pop de
+	pop bc
+	pop af
+	ret
