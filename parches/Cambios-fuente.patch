diff --git a/engine/events/hm_field_access.asm b/engine/events/hm_field_access.asm
new file mode 100644
index 0000000..ae9a8cc
--- /dev/null
+++ b/engine/events/hm_field_access.asm
@@ -0,0 +1,92 @@
+; Field HMs are tools: owning the HM and its badge replaces knowing a move.
+; Keep the seven HM quantities in the existing TM/HM pocket and use a living
+; party member only for the field animation. No new saved RAM is required.
+
+IsHMFieldMove:
+; d = move. Carry means HM; c = zero-based HM number.
+	ld hl, .Moves
+	ld c, 0
+.loop
+	ld a, [hli]
+	and a
+	ret z
+	cp d
+	jr z, .found
+	inc c
+	jr .loop
+.found
+	scf
+	ret
+.Moves
+	db CUT, FLY, SURF, STRENGTH, FLASH, WHIRLPOOL, WATERFALL, 0
+
+CheckFieldMoveHM:
+; d = HM move. Carry on missing HM or no living party member.
+	call IsHMFieldMove
+	jr nc, .failed
+	ld b, 0
+	ld hl, wTMsHMs + NUM_TMS
+	add hl, bc
+	ld a, [hl]
+	and a
+	jr z, .failed
+	jp SelectLivingHMUser
+.failed
+	scf
+	ret
+
+SelectLivingHMUser:
+; Select a non-egg, unmarked, conscious party member for the animation.
+	ld a, [wNuzlockeRunEnded]
+	and a
+	jr nz, .failed
+	ld e, 0
+.loop
+	ld a, [wPartyCount]
+	cp e
+	jr z, .failed
+	ld d, 0
+	ld hl, wPartySpecies
+	add hl, de
+	ld a, [hl]
+	and a
+	jr z, .next
+	cp EGG
+	jr z, .next
+	cp -1
+	jr z, .next
+	ld a, e
+	ld hl, wPartyMon1CaughtLocation
+	call GetPartyLocation
+	bit NUZLOCKE_DEAD_F, [hl]
+	jr nz, .next
+	ld a, e
+	ld hl, wPartyMon1HP
+	call GetPartyLocation
+	ld a, [hli]
+	or [hl]
+	jr z, .next
+	ld a, e
+	ld [wCurPartyMon], a
+	and a
+	ret
+.next
+	inc e
+	jr .loop
+.failed
+	scf
+	ret
+
+CheckFlyMapAccess:
+; Called after a visited map destination has been selected.
+	ld d, FLY
+	call CheckFieldMoveHM
+	ret c
+	ld de, ENGINE_STORMBADGE
+	farcall CheckEngineFlag
+	ret c
+	call GetMapEnvironment
+	call CheckOutdoorMap
+	ret z
+	scf
+	ret
