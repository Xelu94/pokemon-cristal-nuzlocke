diff --git a/tools/add_tito_centers.py b/tools/add_tito_centers.py
new file mode 100644
index 0000000..ce220eb
--- /dev/null
+++ b/tools/add_tito_centers.py
@@ -0,0 +1,19 @@
+"""Apply the same local script/object wrapper to every real first-floor center.
+
+This is an idempotent mechanical map edit. Link floors and beta maps are
+excluded. The special Indigo Plateau layout uses a separate safe coordinate.
+"""
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[1]
+for path in sorted((root / "maps").glob("*Pokecenter1F.asm")):
+    source = path.read_text(encoding="utf-8")
+    name = path.stem + "TitoXeluis"
+    if name + ":" in source:
+        continue
+    index = source.index(path.stem + "_MapEvents:")
+    source = source[:index] + name + ":\n\tfaceplayer\n\topentext\n\tcallasm TitoXeluisServices\n\tclosetext\n\tend\n\n" + source[index:]
+    x, y = (3, 11) if path.stem == "IndigoPlateauPokecenter1F" else (6, 4)
+    source += f"\tobject_event {x:2}, {y:2}, SPRITE_TITO_XELUIS, SPRITEMOVEDATA_STANDING_DOWN, 0, 0, -1, -1, PAL_NPC_BROWN, OBJECTTYPE_SCRIPT, 0, {name}, -1\n"
+    path.write_text(source, encoding="utf-8", newline="\n")
+    print(path.name)
diff --git a/tools/balanced_randomizer.py b/tools/balanced_randomizer.py
new file mode 100644
index 0000000..9071693
--- /dev/null
+++ b/tools/balanced_randomizer.py
@@ -0,0 +1,452 @@
+#!/usr/bin/env python3
+"""Reproducible Crystal randomizer. Read tracked originals, emit balanced tables.
+
+No ROM bytes or third-party randomizer are needed. Species, evolution methods,
+stats, learnsets and trainer/map references come from this source tree. Run from
+the repository root: py -3 tools/balanced_randomizer.py --seed 20261013
+"""
+import argparse
+import collections
+import hashlib
+import json
+import pathlib
+import random
+import re
+import subprocess
+import zipfile
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+LEGENDS = set("ARTICUNO ZAPDOS MOLTRES MEWTWO MEW RAIKOU ENTEI SUICUNE LUGIA HO_OH CELEBI".split())
+JOHTO_BOSSES = {"FALKNER": 14, "BUGSY": 19, "WHITNEY": 24, "MORTY": 30,
+                "CHUCK": 35, "JASMINE": 39, "PRYCE": 43, "CLAIR": 48}
+KANTO_BOSSES = {"LT_SURGE": 62, "SABRINA": 65, "ERIKA": 68, "JANINE": 70,
+                "MISTY": 72, "BROCK": 75, "BLAINE": 78, "BLUE": 80}
+LEAGUE_BOSSES = {"WILL": 52, "KOGA": 54, "BRUNO": 56, "KAREN": 58, "CHAMPION": 60, "RED": 90}
+KANTO_NAMES = ("Pallet", "Viridian", "Pewter", "Cerulean", "Vermilion", "Lavender",
+               "Celadon", "Saffron", "Fuchsia", "Cinnabar", "Seafoam", "RockTunnel",
+               "DiglettsCave", "MountMoon", "PowerPlant", "FastShip", "SilverCave")
+
+
+def original(path):
+    """HEAD originals make a second seed run safe and deterministic."""
+    snapshot = ROOT / "tools/randomizer_originals.zip"
+    if snapshot.exists():
+        with zipfile.ZipFile(snapshot) as archive:
+            return archive.read(path).decode("utf-8")
+    return subprocess.check_output(["git", "show", "HEAD:" + path], cwd=ROOT).decode("utf-8")
+
+
+def write(path, value):
+    target = ROOT / path
+    target.parent.mkdir(parents=True, exist_ok=True)
+    target.write_text(value, encoding="utf-8", newline="\n")
+
+
+def scale_johto(level):
+    anchors = [(1, 5), (5, 9), (9, 14), (16, 19), (20, 24), (25, 30),
+               (30, 35), (35, 39), (40, 48), (50, 60), (100, 100)]
+    for (a, b), (c, d) in zip(anchors, anchors[1:]):
+        if a <= level <= c:
+            return round(b + (level - a) * (d - b) / (c - a))
+    return min(100, level)
+
+
+def is_kanto(name):
+    match = re.match(r"Route(\d+)(?:\D|$)", name)
+    return bool(match and int(match[1]) <= 25) or name.startswith(KANTO_NAMES)
+
+
+class Randomizer:
+    def __init__(self, seed):
+        self.seed = seed
+        self.rng = random.Random(seed)
+        self.report = {"seed": seed, "wild": [], "trainers": [], "events": [], "trades": {}}
+        const = original("constants/pokemon_constants.asm")
+        self.species = re.findall(r"^\s*const ([A-Z][A-Z0-9_]+)\s*(?:;[^\n]*)?$", const, re.M)[:251]
+        assert len(self.species) == 251
+        self.ids = {mon: i + 1 for i, mon in enumerate(self.species)}
+        self.stats, self.types, self.growth = {}, {}, {}
+        for mon in self.species:
+            source = original("data/pokemon/base_stats/" + mon.lower() + ".asm")
+            numbers = re.search(r"^\s*db\s+(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)", source, re.M)
+            self.stats[mon] = list(map(int, numbers.groups()))
+            self.types[mon] = re.search(r"db ([A-Z_]+), ([A-Z_]+) ; type", source).groups()
+            self.growth[mon] = re.search(r"db (GROWTH_[A-Z_]+)", source).group(1)
+        self.bst = {mon: sum(stats) for mon, stats in self.stats.items()}
+        evo = original("data/pokemon/evos_attacks.asm")
+        labels = re.findall(r"^(\w+)EvosAttacks:\n(.*?)(?=^\w+EvosAttacks:|\Z)", evo, re.M | re.S)
+        normalized = {re.sub("[^A-Z0-9]", "", mon): mon for mon in self.species}
+        self.moves, self.parents, self.evolutions = {}, {}, collections.defaultdict(list)
+        for label, body in labels:
+            mon = normalized[label.upper()]
+            self.moves[mon] = [(int(lvl), move) for lvl, move in re.findall(r"^\s*db\s+(\d+),\s*([A-Z_]+)\s*$", body, re.M)]
+            for method, args in re.findall(r"^\s*db (EVOLVE_\w+), ([^\n;]+)", body, re.M):
+                bits = [a.strip() for a in args.split(",")]
+                child = bits[-1]
+                if method in ("EVOLVE_LEVEL", "EVOLVE_STAT"):
+                    threshold = int(bits[0])
+                elif method == "EVOLVE_TRADE":
+                    threshold = 36 if child in {"ALAKAZAM", "MACHAMP", "GOLEM", "GENGAR"} else 40
+                elif method == "EVOLVE_HAPPINESS":
+                    threshold = 12 if mon in {"PICHU", "CLEFFA", "IGGLYBUFF", "TOGEPI"} else 25
+                else:
+                    threshold = 24 if mon in {"PIKACHU", "CLEFAIRY", "JIGGLYPUFF"} else 30
+                self.parents[child] = (mon, threshold)
+                self.evolutions[mon].append((child, threshold))
+        self.minlevel, self.stage = {}, {}
+        for mon in self.species:
+            cur, minlevel, stage = mon, 1, 0
+            while cur in self.parents:
+                cur, lvl = self.parents[cur]
+                minlevel = max(minlevel, lvl)
+                stage += 1
+            self.minlevel[mon], self.stage[mon] = minlevel, stage
+        # Trade phase describes remaining evolution, so a one-evolution final
+        # form (Gyarados) can match a fully grown one-stage species of similar
+        # strength without being reduced to a weak unevolved youngster.
+        self.trade_phase = {m: (2 if not self.evolutions[m] else 1 if m in self.parents else 0)
+                            for m in self.species}
+        self.move_data = {}
+        for name, power, kind, pp in re.findall(r"^\s*move ([A-Z_]+),\s*\w+,\s*(\d+),\s*(\w+),\s*\d+,\s*(\d+),", original("data/moves/moves.asm"), re.M):
+            self.move_data[name] = (int(power), kind, int(pp))
+        self.starters = {}
+        starter_pool = [mon for mon in self.species if mon not in self.parents and mon not in LEGENDS
+                        and 280 <= self.bst[mon] <= 340 and self.evolutions[mon]
+                        and self.has_attack(mon, 5)]
+        used_types = set()
+        for old in ("CHIKORITA", "CYNDAQUIL", "TOTODILE"):
+            chosen = self.rng.choice([m for m in starter_pool if self.types[m][0] not in used_types])
+            self.starters[old] = chosen
+            used_types.add(self.types[chosen][0])
+        self.report["starters"] = self.starters
+        self.rival_families = {}
+
+    def family_root(self, mon):
+        while mon in self.parents:
+            mon = self.parents[mon][0]
+        return mon
+
+    def family_strength(self, mon):
+        return max([self.bst[mon]] + [self.family_strength(child) for child, _ in self.evolutions[mon]])
+
+    def legal_moves(self, mon, level):
+        moves = []
+        if mon in self.parents:
+            parent, threshold = self.parents[mon]
+            moves.extend(self.legal_moves(parent, min(level, threshold)))
+        moves.extend(move for lvl, move in self.moves[mon] if lvl <= level)
+        return list(dict.fromkeys(moves))
+
+    def has_attack(self, mon, level):
+        return any(self.move_data.get(move, (0,))[0] > 0 or move in {"NIGHT_SHADE", "SEISMIC_TOSS", "SONICBOOM", "DRAGON_RAGE", "PSYWAVE"}
+                   for move in self.legal_moves(mon, level))
+
+    def pool(self, level, strong=False, legends=True):
+        if level < 10:
+            low, high = 180, 360
+        elif level < 16:
+            low, high = 220, 405
+        elif level < 24:
+            low, high = 260, 465
+        elif level < 35:
+            low, high = 320, 525
+        elif level < 50:
+            low, high = 380, 580
+        else:
+            low, high = 420, 680
+        if strong:
+            low += 30
+        return [mon for mon in self.species if self.minlevel[mon] <= level
+                and low <= self.bst[mon] <= high and self.has_attack(mon, level)
+                and (mon not in LEGENDS or (legends and level >= 55))]
+
+    def choose(self, level, strong=False, exclude=()):
+        choices = [m for m in self.pool(level, strong) if m not in exclude]
+        return self.rng.choice(choices or self.pool(level))
+
+    def evolved(self, mon, level):
+        while True:
+            options = [(child, lvl) for child, lvl in self.evolutions[mon] if lvl <= level]
+            if not options:
+                return mon
+            mon = options[0][0]
+
+    def moveset(self, mon, level):
+        known = self.legal_moves(mon, level)
+        # One best STAB move, one other attack and up to two useful support moves.
+        attacks = [m for m in known if self.move_data.get(m, (0,))[0] > 0]
+        attacks.sort(key=lambda m: self.move_data[m][0] * (1.5 if self.move_data[m][1] in self.types[mon] else 1), reverse=True)
+        chosen = attacks[:2]
+        support = [m for m in known if m not in chosen and m != "SPLASH"]
+        priority = {"SLEEP_POWDER": 10, "HYPNOSIS": 9, "THUNDER_WAVE": 9, "CONFUSE_RAY": 8,
+                    "LEECH_SEED": 7, "SYNTHESIS": 7, "RECOVER": 7, "MILK_DRINK": 7,
+                    "REFLECT": 6, "LIGHT_SCREEN": 6, "SWORDS_DANCE": 6, "AMNESIA": 6}
+        support.sort(key=lambda m: (priority.get(m, 0), known.index(m)), reverse=True)
+        chosen.extend(support[:4 - len(chosen)])
+        return (chosen + ["NO_MOVE"] * 4)[:4]
+
+    def wild(self):
+        for name in ("johto_grass", "johto_water", "kanto_grass", "kanto_water", "swarm_grass", "swarm_water"):
+            path = "data/wild/" + name + ".asm"
+            source = original(path)
+            def row(match):
+                lvl, old = int(match[1]), match[2]
+                newlvl = min(75, max(50, lvl + 35)) if name.startswith("kanto") else scale_johto(lvl)
+                mon = self.choose(newlvl)
+                self.report["wild"].append([name, old, lvl, mon, newlvl])
+                return "\tdb %d, %s" % (newlvl, mon)
+            source = re.sub(r"^\s*db\s+(\d+),\s*([A-Z][A-Z0-9_]+)\s*(?=\n|;)", row, source, flags=re.M)
+            write(path, source)
+        for name in ("fish", "treemons"):
+            path = "data/wild/" + name + ".asm"
+            source = original(path)
+            def row(match):
+                prefix, old, lvl = match[1], match[2], int(match[3])
+                newlvl = scale_johto(lvl)
+                if name == "treemons" and "TreeMonSet_Kanto:" in source[:match.start()] and "TreeMonSet_Lake:" not in source[:match.start()]:
+                    newlvl = 55
+                mon = self.choose(newlvl)
+                self.report["wild"].append([name, old, lvl, mon, newlvl])
+                return prefix + mon + ", " + str(newlvl)
+            source = re.sub(r"(^\s*db\s+(?:\d+\s*percent(?:\s*\+\s*1)?|\d+),\s*)([A-Z][A-Z0-9_]+),\s*(\d+)", row, source, flags=re.M)
+            if name == "fish":
+                def timed(match):
+                    first, lvl1, second, lvl2 = match.groups()
+                    lvl1, lvl2 = scale_johto(int(lvl1)), scale_johto(int(lvl2))
+                    return "\tdb %s, %d, %s, %d" % (self.choose(lvl1), lvl1, self.choose(lvl2), lvl2)
+                source = re.sub(r"^\s*db ([A-Z][A-Z0-9_]+),\s*(\d+),\s*([A-Z][A-Z0-9_]+),\s*(\d+)", timed, source, flags=re.M)
+            write(path, source)
+        path = "data/wild/bug_contest_mons.asm"
+        def contest(match):
+            chance, old, low, high = match.groups()
+            low, high = max(12, scale_johto(int(low))), max(18, scale_johto(int(high)))
+            mon = self.choose(low)
+            self.report["wild"].append(["contest", old, int(match[3]), mon, low])
+            return "\tdb %s, %s, %d, %d" % (chance, mon, low, max(low, high))
+        write(path, re.sub(r"^\s*db\s+(-?\d+),\s*([A-Z][A-Z0-9_]+),\s*(\d+),\s*(\d+)", contest, original(path), flags=re.M))
+
+    def trainers(self):
+        constants = {}
+        cls = None
+        for line in original("constants/trainer_constants.asm").splitlines():
+            match = re.match(r"\s*trainerclass (\w+)", line)
+            if match:
+                cls, number = match[1], 0
+            match = re.match(r"\s*const (\w+)", line)
+            if match and cls:
+                number += 1
+                constants[(cls, number)] = match[1]
+        kanto_ids = set()
+        for file in sorted((ROOT / "maps").glob("*.asm")):
+            if is_kanto(file.stem):
+                for cls, name in re.findall(r"\b(?:trainer|loadtrainer) (\w+), (\w+)", original("maps/" + file.name)):
+                    kanto_ids.add((cls, name))
+        source = original("data/trainers/parties.asm")
+        blocks = re.split(r'(^\s*db "[^\n]+TRAINERTYPE_\w+\s*\n)', source, flags=re.M)
+        group, trainer_index, class_name = None, 0, None
+        output = blocks[0]
+        for i in range(1, len(blocks), 2):
+            header, body = blocks[i:i + 2]
+            before = output.splitlines()
+            comment = next((s for s in reversed(before) if re.match(r"\s*; \w+ \(\d+\)", s)), "")
+            parsed = re.match(r"\s*; (\w+) \((\d+)\)", comment)
+            if not parsed:
+                raise ValueError("trainer metadata missing: " + header)
+            class_name, trainer_index = parsed[1], int(parsed[2])
+            name = constants.get((class_name, trainer_index), "")
+            rows = list(re.finditer(r"^\s*db\s+(\d+),\s*([A-Z][A-Z0-9_]+)([^\n]*)", body, re.M))
+            if not rows:
+                output += header + body
+                continue
+            oldmax = max(int(row[1]) for row in rows)
+            target = {**JOHTO_BOSSES, **KANTO_BOSSES, **LEAGUE_BOSSES}.get(class_name)
+            boss = target is not None
+            kanto = (class_name, name) in kanto_ids or class_name in KANTO_BOSSES
+            if class_name == "RIVAL1":
+                target = [7, 21, 31, 42, 50][(trainer_index - 1) // 3]
+            elif class_name == "RIVAL2":
+                target = 76 if trainer_index <= 3 else 80
+            elif target is None:
+                target = min(76, max(55, oldmax + 30)) if kanto else scale_johto(oldmax)
+            used, newrows = [], []
+            for j, row in enumerate(rows):
+                level = max(5, target - max(0, oldmax - int(row[1])))
+                if kanto:
+                    level = max(55, level)
+                if class_name == "RED":
+                    level = max(85, level)
+                old = row[2]
+                if class_name.startswith("RIVAL") and old in {"CHIKORITA", "BAYLEEF", "MEGANIUM", "CYNDAQUIL", "QUILAVA", "TYPHLOSION", "TOTODILE", "CROCONAW", "FERALIGATR"}:
+                    oldstarter = ("CHIKORITA", "CYNDAQUIL", "TOTODILE")[(trainer_index - 1) % 3]
+                    mon = self.evolved(self.starters[oldstarter], level)
+                elif class_name.startswith("RIVAL"):
+                    branch = (trainer_index - 1) % 3
+                    oldstarter = ("CHIKORITA", "CYNDAQUIL", "TOTODILE")[branch]
+                    key = (branch, self.family_root(old))
+                    if key not in self.rival_families:
+                        used_roots = {root for (b, _), root in self.rival_families.items() if b == branch}
+                        used_roots.add(self.starters[oldstarter])
+                        candidates = [m for m in self.pool(level) if self.family_root(m) not in used_roots
+                                      and self.family_strength(self.family_root(m)) >= 450]
+                        chosen = self.rng.choice(candidates)
+                        self.rival_families[key] = self.family_root(chosen)
+                    mon = self.evolved(self.rival_families[key], level)
+                else:
+                    mon = self.choose(level, strong=boss, exclude=used)
+                used.append(mon)
+                # Keep held items; regenerate every move from the new species' legal learnset.
+                args = [a.strip() for a in row[3].split(",") if a.strip()]
+                item = args[0] if "TRAINERTYPE_ITEM" in header else None
+                values = [str(level), mon] + ([item] if item else [])
+                if "MOVES" in header:
+                    values += self.moveset(mon, level)
+                newrows.append("\tdb " + ", ".join(values))
+            if boss:
+                while len(newrows) < 3:
+                    level = target - 2
+                    mon = self.choose(level, strong=True, exclude=used)
+                    used.append(mon)
+                    values = [str(level), mon]
+                    if "MOVES" in header:
+                        values += self.moveset(mon, level)
+                    newrows.append("\tdb " + ", ".join(values))
+            # Normal/item parties already derive level-up moves from the new
+            # species in TryAddMonToParty; keeping their compact encoding also
+            # preserves the original ROM bank layout.
+            newheader = header
+            # Replace only mon rows; trailing next-group and metadata comments remain intact.
+            start, stop = rows[0].start(), rows[-1].end()
+            output += newheader + body[:start] + "\n".join(newrows) + body[stop:]
+            self.report["trainers"].append({"class": class_name, "id": trainer_index,
+                                            "name": name, "kanto": kanto, "ace": target, "team": newrows})
+        write("data/trainers/parties.asm", output)
+
+    def events(self):
+        for file in sorted((ROOT / "maps").glob("*.asm")):
+            path = "maps/" + file.name
+            source = original(path)
+            def encounter(match):
+                command, old, literal = match.groups()
+                level = 5 if literal == "EGG_LEVEL" else int(literal)
+                if path == "maps/ElmsLab.asm":
+                    chosen, newlevel = self.starters[old], level
+                elif command == "giveegg":
+                    chosen, newlevel = self.choose(5), level
+                else:
+                    newlevel = max(55, level + 20) if is_kanto(file.stem) else scale_johto(level)
+                    # Tutorial capture stays safe at level 5; reward encounters stay in their tier.
+                    if file.stem == "Route29":
+                        newlevel = 5
+                    chosen = self.choose(newlevel, strong=command == "loadwildmon")
+                self.report["events"].append([path, command, old, chosen, newlevel])
+                self.event_replacements[(path, old)] = chosen
+                return "\t%s %s, %s" % (command, chosen, literal if command == "giveegg" else newlevel)
+            changed = re.sub(r"^\s*(givepoke|giveegg|loadwildmon) ([A-Z][A-Z0-9_]+), (\d+|EGG_LEVEL)", encounter, source, flags=re.M)
+            if path == "maps/ElmsLab.asm":
+                for old, chosen in self.starters.items():
+                    changed = re.sub(r"(\b(?:pokepic|cry) )" + old + r"\b", r"\g<1>" + chosen, changed)
+                    changed = re.sub(r"(getmonname STRING_BUFFER_3, )" + old + r"\b", r"\g<1>" + chosen, changed)
+                for label in ("TakeCyndaquilText", "TakeTotodileText", "TakeChikoritaText"):
+                    changed = re.sub(label + r":\n.*?\tdone", label + ':\n\ttext "ELM: ¿Quieres este"\n\tline "#MON aleatorio?"\n\tdone', changed, flags=re.S)
+            else:
+                for (p, old), chosen in self.event_replacements.items():
+                    if p == path:
+                        changed = re.sub(r"(\b(?:cry|pokepic) )" + old + r"\b", r"\g<1>" + chosen, changed)
+            if file.stem == "DragonShrine":
+                changed = changed.replace("\tspecial GiveDratini", "\t; randomized gift uses its own level-up moves")
+            if changed != source:
+                write(path, changed)
+        # Gift with a dedicated engine routine; return identity follows the randomized species.
+        path = "engine/events/shuckle.asm"
+        source = original(path)
+        chosen = self.choose(19)
+        source = source.replace("ld a, SHUCKLE", "ld a, " + chosen).replace("cp SHUCKLE", "cp " + chosen)
+        source = source.replace("ld a, 15", "ld a, 19")
+        write(path, source)
+        self.report["events"].append([path, "gift", "SHUCKLE", chosen, 19])
+        # Roaming identity, map movement and event flags are independent of species.
+        path = "engine/overworld/wildmons.asm"
+        source = original(path)
+        start, end = source.index("InitRoamMons:"), source.index("CheckEncounterRoamMon:")
+        part = source[start:end]
+        for old in ("RAIKOU", "ENTEI"):
+            chosen = self.choose(48, strong=True)
+            self.roam[old] = chosen
+            part = part.replace("ld a, " + old, "ld a, " + chosen)
+            self.report["events"].append([path, "roamer", old, chosen, 48])
+        part = part.replace("ld a, 40", "ld a, 48")
+        write(path, source[:start] + part + source[end:])
+        # Scripts checking roaming capture must use the randomized species too.
+        for path in ("maps/TinTower1F.asm",):
+            source = (ROOT / path).read_text(encoding="utf-8")
+            for old, chosen in self.roam.items():
+                source = source.replace("setval " + old, "setval " + chosen)
+            write(path, source)
+        self.odd_eggs()
+
+    def odd_eggs(self):
+        # Twenty equally likely randomized eggs; exactly one row is shiny (5%).
+        # The full mon structure is regenerated, including legal moves, PP, EXP
+        # and stats, rather than changing a species byte in an old baby's struct.
+        lines = ["DEF NUM_ODD_EGGS EQU 20", "", "OddEggProbabilities:",
+                 "\ttable_width 2"]
+        lines.extend("\tdw %d * $ffff / 20" % n for n in range(1, 21))
+        lines.extend(["\tassert_table_length NUM_ODD_EGGS", "", "OddEggs:",
+                      "\ttable_width NICKNAMED_MON_STRUCT_LENGTH"])
+        used = []
+        for n in range(20):
+            mon = self.choose(5, exclude=used)
+            used.append(mon)
+            moves = self.moveset(mon, 5)
+            dvs = [2, 10, 10, 10] if n == 0 else [8, 8, 8, 8]
+            hp_dv = ((dvs[0] & 1) << 3) | ((dvs[1] & 1) << 2) | ((dvs[2] & 1) << 1) | (dvs[3] & 1)
+            stats = [(base + dv) * 10 // 100 + (15 if j == 0 else 5)
+                     for j, (base, dv) in enumerate(zip(self.stats[mon], [hp_dv, dvs[0], dvs[1], dvs[2], dvs[3], dvs[3]]))]
+            exp = {"GROWTH_MEDIUM_FAST": 125, "GROWTH_MEDIUM_SLOW": 135,
+                   "GROWTH_FAST": 100, "GROWTH_SLOW": 156}[self.growth[mon]]
+            pps = [self.move_data[m][2] if m != "NO_MOVE" else 0 for m in moves]
+            lines.extend(["", "\tdb " + mon, "\tdb NO_ITEM", "\tdb " + ", ".join(moves),
+                          "\tdw 2048", "\tbigdt " + str(exp)] + ["\tbigdw 0"] * 5 +
+                         ["\tdn " + ", ".join(map(str, dvs)), "\tdb " + ", ".join(map(str, pps)),
+                          "\tdb 20 ; egg steps", "\tdb 0, 0, 0 ; Pokerus, caught data",
+                          "\tdb 5", "\tdb 0, 0 ; status", "\tbigdw 0 ; current HP"] +
+                         ["\tbigdw " + str(s) for s in stats] + ['\tdname "HUEVO", MON_NAME_LENGTH'])
+            self.report["events"].append(["data/events/odd_eggs.asm", "egg", mon, 5, n == 0])
+        lines.append("\tassert_table_length NUM_ODD_EGGS")
+        write("data/events/odd_eggs.asm", "\n".join(lines) + "\n")
+
+    def trades(self):
+        rows = []
+        for mon in self.species:
+            candidates = [other for other in self.species if other != mon
+                          and self.trade_phase[other] == self.trade_phase[mon]
+                          and abs(self.bst[other] - self.bst[mon]) <= 60
+                          and self.minlevel[other] <= self.minlevel[mon]
+                          and (other in LEGENDS) == (mon in LEGENDS)]
+            if not candidates:
+                # Rare single-species tiers: closest power from the same evolution stage.
+                candidates = [mon]
+            choices = self.rng.sample(candidates, min(8, len(candidates)))
+            choices = (choices * 8)[:8]
+            rows.append("\tdb " + ", ".join(choices) + " ; " + mon)
+            self.report["trades"][mon] = choices
+        write("data/events/balanced_trade_pools.asm", "; Generated: same evolution stage, similar base-stat total.\nBalancedTradePools:\n" + "\n".join(rows) + "\n\tassert @ - BalancedTradePools == NUM_POKEMON * 8\n")
+
+    def run(self):
+        self.event_replacements, self.roam = {}, {}
+        self.wild()
+        self.trainers()
+        self.events()
+        self.trades()
+        self.report["pool_rules"] = {"min_evolution_level": True, "legendary_min_level": 55,
+                                      "early_bst_cap": 360, "trade_max_bst_difference": 60}
+        write("data/events/randomization_manifest.json", json.dumps(self.report, indent=2, ensure_ascii=False) + "\n")
+        print("Seed:", self.seed, "Starters:", self.starters)
+        print("Randomized slots:", len(self.report["wild"]), "Trainer teams:", len(self.report["trainers"]), "Events:", len(self.report["events"]))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--seed", type=int, default=20261013)
+    args = parser.parse_args()
+    Randomizer(args.seed).run()
diff --git a/tools/build_dark_lugia_sprite.py b/tools/build_dark_lugia_sprite.py
new file mode 100644
index 0000000..3d99491
--- /dev/null
+++ b/tools/build_dark_lugia_sprite.py
@@ -0,0 +1,46 @@
+"""Builds gfx/pokemon/dark_lugia/front.png and back.png.
+
+front.png: the user-supplied animated Dark Lugia sprite (video, 280x280 = 56x56 pixels scaled by 5).
+Frame 0 is the idle pose, frames 1-3 are the wing-flap poses. Colours are reduced to the four
+colours of the Dark Lugia palette. back.png: Lugia's back view recoloured with the same palette.
+Usage: build_dark_lugia_sprite.py <frames_dir> <idle> <flap> <flap> <flap>   (frame numbers in frames_dir)"""
+import sys
+from collections import Counter
+from pathlib import Path
+from PIL import Image
+
+PALETTE = [(255, 255, 255), (99, 82, 140), (66, 41, 90), (0, 0, 0)]
+REF = [(255, 255, 255), (100, 79, 136), (62, 44, 90), (0, 0, 0)]
+
+
+def nearest(c):
+    return min(range(4), key=lambda i: sum((c[k] - REF[i][k]) ** 2 for k in range(3)))
+
+
+def shrink(path):
+    im = Image.open(path).convert('RGB')
+    out = Image.new('RGB', (56, 56))
+    for y in range(56):
+        for x in range(56):
+            block = Counter(nearest(im.getpixel((x * 5 + i, y * 5 + j))) for i in range(5) for j in range(5))
+            out.putpixel((x, y), PALETTE[block.most_common(1)[0][0]])
+    return out
+
+
+def main():
+    frames_dir = Path(sys.argv[1])
+    numbers = [int(n) for n in sys.argv[2:]]
+    sheet = Image.new('RGB', (56, 56 * len(numbers)))
+    for i, n in enumerate(numbers):
+        sheet.paste(shrink(frames_dir / ('f%03d.png' % n)), (0, 56 * i))
+    out = Path('gfx/pokemon/dark_lugia')
+    sheet.save(out / 'front.png')
+    back = Image.open('gfx/pokemon/lugia/back.png')
+    recolor = Image.new('RGB', back.size)
+    for y in range(back.height):
+        for x in range(back.width):
+            recolor.putpixel((x, y), PALETTE[back.getpixel((x, y))])
+    recolor.save(out / 'back.png')
+
+
+main()
