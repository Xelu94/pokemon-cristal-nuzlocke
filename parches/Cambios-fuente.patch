diff --git a/engine/pokemon/custom_shiny.asm b/engine/pokemon/custom_shiny.asm
new file mode 100644
index 0000000..f09b073
--- /dev/null
+++ b/engine/pokemon/custom_shiny.asm
@@ -0,0 +1,44 @@
+PUSHS
+SECTION "Twenty percent shiny mechanics", ROMX
+
+RollFivePercentShinyDVs::
+; Gifts scripted with EVENT_FORCE_SHINY_GIFT set are always shiny.
+	push hl
+	ld hl, wEventFlags + EVENT_FORCE_SHINY_GIFT / 8
+	bit EVENT_FORCE_SHINY_GIFT % 8, [hl]
+	pop hl
+	jr nz, ForceShinyDVs
+; Input/output BC: Attack/Defense and Speed/Special DVs.
+; Rejection sampling followed by mod 20 makes four outcomes in twenty.
+; Preserve DE and HL. Non-shiny rolls cannot accidentally remain shiny.
+.sample
+	call Random
+	cp 240
+	jr nc, .sample
+.modulo
+	cp 20
+	jr c, .result
+	sub 20
+	jr .modulo
+.result
+	cp 4
+	jr c, ForceShinyDVs
+	ld a, c
+	cp $aa
+	ret nz
+	ld a, b
+	and $2f
+	cp $2a
+	ret nz
+	dec b
+	ret
+
+ForceShinyDVs::
+	ld a, b
+	and $f0
+	or $a
+	ld b, a
+	set 5, b
+	ld c, $aa
+	ret
+POPS
