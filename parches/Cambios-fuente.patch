+TitoPrepareBattle::
+; StartBattle can refuse a dead/empty party. Refusal must not award a victory.
+	ld a, DRAW
+	ld [wBattleResult], a
+	ret
+
+SECTION "Tito evolution and introduction", ROMX
+
+TitoEvolutionGuide::
+	ld hl, .Choose
+	call PrintText
+	ld b, PARTYMENUACTION_GIVE_MON
+	farcall SelectTradeOrDayCareMon
+	ret c
+	call TitoEvolutionText
+	jp PrintText
+.Choose
+	text "TITO XELUIS:"
+	line "¿De quién quieres"
+	cont "ver la evolución?"
+	done
+
+TitoEvolutionText::
+; Input: wCurPartySpecies. Return the actual modified method's text in HL.
+	ld a, [wCurPartySpecies]
+	ld c, a
+	ld hl, .Table
+.next
+	ld a, [hli]
+	and a
