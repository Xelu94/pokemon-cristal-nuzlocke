diff --git a/engine/pokemon/hatch_reroll.asm b/engine/pokemon/hatch_reroll.asm
new file mode 100644
index 0000000..35de023
--- /dev/null
+++ b/engine/pokemon/hatch_reroll.asm
@@ -0,0 +1,70 @@
+; Every egg hatches into a random shiny Pokemon of its first evolutionary stage.
+; The egg keeps the four random moves it was created with.
+
+DEF NUM_HATCH_LEGENDARIES EQU 11
+
+SECTION "Hatched egg reroll", ROMX
+
+RerollHatchedEgg::
+.pick
+	call Random
+	and a
+	jr z, .pick
+	cp CELEBI + 1
+	jr nc, .pick
+	ld b, a
+	ld hl, .Legendaries
+	ld c, NUM_HATCH_LEGENDARIES
+.check
+	ld a, [hli]
+	cp b
+	jr z, .pick
+	dec c
+	jr nz, .check
+
+	ld a, b
+	ld [wCurPartySpecies], a
+	callfar GetPreEvolution
+	callfar GetPreEvolution
+	ld a, [wCurPartySpecies]
+	ld [wCurSpecies], a
+	call GetBaseData
+
+	ld a, [wCurPartyMon]
+	ld hl, wPartyMon1
+	ld bc, PARTYMON_STRUCT_LENGTH
+	call AddNTimes
+	ld d, h
+	ld e, l
+	ld a, [wCurPartySpecies]
+	ld [de], a
+
+	ld hl, MON_DVS
+	add hl, de
+	ld a, [hl]
+	and $f0
+	or $2a
+	ld [hli], a
+	ld [hl], $aa
+
+	ld hl, MON_LEVEL
+	add hl, de
+	ld a, [hl]
+	push de
+	ld d, a
+	callfar CalcExpAtLevel
+	pop de
+	ld hl, MON_EXP
+	add hl, de
+	ldh a, [hProduct + 1]
+	ld [hli], a
+	ldh a, [hProduct + 2]
+	ld [hli], a
+	ldh a, [hProduct + 3]
+	ld [hl], a
+	ret
+
+.Legendaries:
+	db ARTICUNO, ZAPDOS, MOLTRES, MEWTWO, MEW
+	db RAIKOU, ENTEI, SUICUNE, LUGIA, HO_OH, CELEBI
+	assert @ - .Legendaries == NUM_HATCH_LEGENDARIES
