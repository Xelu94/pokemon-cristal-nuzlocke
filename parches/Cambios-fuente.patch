+#!/usr/bin/env python3
+"""Validate generated data against evolution, power, moves and difficulty rules."""
+import hashlib
+import json
+import re
+from balanced_randomizer import ROOT, Randomizer, LEGENDS
+
+r = Randomizer(20261013)
+manifest = json.loads((ROOT / "data/events/randomization_manifest.json").read_text(encoding="utf-8"))
+assert len(r.species) == 251
+for location, old, oldlevel, mon, level in manifest["wild"]:
+    assert r.minlevel[mon] <= level, (location, mon, level)
+    assert mon not in LEGENDS or level >= 55, (location, mon, level)
+    if level < 7:
+        assert r.stage[mon] == 0 and r.bst[mon] <= 360, (mon, level)
+for team in manifest["trainers"]:
+    for row in team["team"]:
+        args = row.split("db ")[1].split(", ")
+        level, mon = int(args[0]), args[1]
+        assert 1 <= level <= 100
+        assert r.minlevel[mon] <= level, (team, mon, level)
+        assert mon not in LEGENDS or level >= 55
+        if team["kanto"]:
+            assert level >= 55, (team, level)
+        if team["class"] == "RED":
+            assert 85 <= level <= 90
+        if len(args) > 3:
+            for move in args[-4:]:
+                assert move == "NO_MOVE" or move in r.legal_moves(mon, level), (mon, level, move)
+for mon, candidates in manifest["trades"].items():
+    assert len(candidates) == 8
+    for other in candidates:
+        assert r.trade_phase[mon] == r.trade_phase[other]
+        assert abs(r.bst[mon] - r.bst[other]) <= 60, (mon, other)
+        assert r.minlevel[other] <= r.minlevel[mon], (mon, other)
+        assert (mon in LEGENDS) == (other in LEGENDS)
+for label, level in {"FALKNER": 14, "BUGSY": 19, "WHITNEY": 24, "MORTY": 30,
+                     "CHUCK": 35, "JASMINE": 39, "PRYCE": 43, "CLAIR": 48,
+                     "WILL": 52, "CHAMPION": 60, "LT_SURGE": 62, "BLUE": 80}.items():
+    teams = [t for t in manifest["trainers"] if t["class"] == label]
+    assert teams and all(t["ace"] == level for t in teams), label
+assert len({r.types[s][0] for s in manifest["starters"].values()}) == 3
+eggs = [e for e in manifest["events"] if e[0] == "data/events/odd_eggs.asm"]
+assert len(eggs) == 20 and sum(e[4] for e in eggs) == 4
+lake = (ROOT / "maps/LakeOfRage.asm").read_text(encoding="utf-8")
+assert "BATTLETYPE_FORCESHINY" in lake and "EVENT_LAKE_OF_RAGE_RED_GYARADOS" in lake
+assert not re.search(r"loadwildmon GYARADOS", lake)
+assert "cp [hl]" not in (ROOT / "engine/events/npc_trade.asm").read_text(encoding="utf-8").split("CheckTradeGender:")[0]
+print("Validated 251 species, %d encounters, %d trainer teams, 251 comparable trade pools and 20%% shiny Odd Eggs." %
+      (len(manifest["wild"]), len(manifest["trainers"])))
+print("ROM SHA256:", hashlib.sha256((ROOT / "pokecristal.gbc").read_bytes()).hexdigest())
