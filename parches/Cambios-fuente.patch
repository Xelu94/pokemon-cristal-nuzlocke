index 0000000..6a5b5df
--- /dev/null
+++ b/tools/generate_sandbox_maps.py
@@ -0,0 +1,92 @@
+"""Generate debug-only complete map catalog and verified walkable landing tiles."""
+from pathlib import Path
+import re,json
+P=Path(__file__).resolve().parents[1]
+groups=[];current=None
+for line in (P/'constants/map_constants.asm').read_text(encoding='utf-8').splitlines():
+ m=re.match(r'\s*newgroup\s+(\w+)',line)
+ if m:current={'name':m[1],'id':len(groups)+1,'maps':[]};groups.append(current)
+ m=re.match(r'\s*map_const\s+(\w+),\s*(\d+),\s*(\d+)',line)
+ if m:current['maps'].append({'constant':m[1],'width':int(m[2]),'height':int(m[3]),'id':len(current['maps'])+1,'group':current['id']})
+maprows=[]
+for line in (P/'data/maps/maps.asm').read_text(encoding='utf-8').splitlines():
+ m=re.match(r'\s*map\s+(\w+),\s*(\w+),\s*(\w+)',line)
+ if m:maprows.append(m.groups())
+flat=[m for g in groups for m in g['maps']];assert len(flat)==len(maprows),(len(flat),len(maprows))
+# Resolve all source block aliases to their INCBIN files.
+blocks={};pending=[]
+for line in (P/'data/maps/blocks.asm').read_text(encoding='utf-8').splitlines():
+ m=re.match(r'(\w+)_Blocks:',line)
+ if m:pending.append(m[1])
+ m=re.search(r'INCBIN "([^"]+)"',line)
+ if m:
+  for n in pending:blocks[n]=P/m[1]
+  pending=[]
+# Resolve tileset collision aliases to their source tables.
+collpaths={};pending=[]
+for line in (P/'gfx/tilesets.asm').read_text(encoding='utf-8').splitlines():
+ m=re.match(r'(\w+)Coll::?',line)
+ if m:pending.append(m[1])
+ m=re.search(r'INCLUDE "([^"]+_collision.asm)"',line)
+ if m:
+  for n in pending:collpaths[n]=P/m[1]
+  pending=[]
+constants=re.findall(r'^\s*const\s+(TILESET_\w+)',(P/'constants/tileset_constants.asm').read_text(),re.M)
+sets=re.findall(r'^\s*tileset\s+(\w+)',(P/'data/tilesets.asm').read_text(),re.M)[1:]
+assert len(constants)==len(sets)
+collisions={}
+for c,n in zip(constants,sets):
+ path=collpaths[n];collisions[c]=[re.match(r'\s*tilecoll\s+(\w+),\s*(\w+),\s*(\w+),\s*(\w+)',l).groups() for l in path.read_text().splitlines() if re.match(r'\s*tilecoll\s+',l)]
+spanish=['OLIVO','CAOBA','MAZMORRAS','IRIS','ENDRINO','ISLA CANELA','CELESTE','AZALEA','LAGO FURIA','VIOLETA','TRIGAL','CARMÍN','PALETA','PLATEADA','BARCO','LIGA','FUCSIA','LAVANDA','MONTE PLATEADO','CLUB CABLE','AZULONA','ORQUÍDEA','VERDE','PRIMAVERA','AZAFRÁN','CEREZO']
+replace={'OLIVINE':'OLIVO','MAHOGANY':'CAOBA','ECRUTEAK':'IRIS','BLACKTHORN':'ENDRINO','CINNABAR':'CANELA','CERULEAN':'CELESTE','LAKE_OF_RAGE':'LAGO FURIA','VIOLET':'VIOLETA','GOLDENROD':'TRIGAL','VERMILION':'CARMIN','PALLET':'PALETA','PEWTER':'PLATEADA','FUCHSIA':'FUCSIA','LAVENDER':'LAVANDA','SILVER_CAVE':'M.PLATEADO','CELADON':'AZULONA','CIANWOOD':'ORQUIDEA','VIRIDIAN':'VERDE','NEW_BARK':'PRIMAVERA','SAFFRON':'AZAFRAN','CHERRYGROVE':'CEREZO','POKECENTER':'CENTRO','HOUSE':'CASA','GYM':'GIM','MART':'TIENDA','ROUTE':'RUTA','GATE':'PASO','SPROUT_TOWER':'T.BELLSPROUT','TIN_TOWER':'T.HO-OH','BURNED_TOWER':'T.QUEMADA','TEAM_ROCKET_BASE':'BASE ROCKET','UNION_CAVE':'C.UNION','RUINS_OF_ALPH':'RUINAS ALFA','UNDERGROUND':'SUBT','WHIRL_ISLAND':'REMOLINO','MOUNT_MORTAR':'M.MORTERO','ICE_PATH':'R.HELADA','DARK_CAVE':'C.OSCURA','DRAGONS_DEN':'G.DRAGON','RADIO_TOWER':'T.RADIO','POKEMON':'POKEMON','NATIONAL_PARK':'PARQUE','LIGHTHOUSE':'FARO','DEPT_STORE':'C.COMERCIAL'}
+for m,(asm,tileset,env) in zip(flat,maprows):
+ m.update(asm=asm,tileset=tileset,environment=env)
+ text=(P/'maps'/f'{asm}.asm').read_text(encoding='utf-8')
+ warps=[(int(a),int(b)) for a,b in re.findall(r'^\s*warp_event\s+(\d+),\s*(\d+)',text,re.M)]
+ blocked=set(warps)
+ for kind in ['object_event','coord_event']:
+  blocked.update((int(a),int(b)) for a,b in re.findall(r'^\s*'+kind+r'\s+(\d+),\s*(\d+)',text,re.M))
+ if warps:
+  x,y=warps[0];y+=1 if env in ['TOWN','ROUTE'] else -1
+ else:x,y=m['width'],m['height']
+ x=max(0,min(m['width']*2-1,x));y=max(0,min(m['height']*2-1,y));target=(x,y)
+ raw=blocks[asm].read_bytes();assert len(raw)==m['width']*m['height'],(asm,len(raw),m['width'],m['height'])
+ cells=collisions[tileset]; candidates=[]
+ for yy in range(m['height']*2):
+  for xx in range(m['width']*2):
+   if (xx,yy) in blocked:continue
+   c=cells[raw[(yy//2)*m['width']+xx//2]][(yy%2)*2+xx%2]
+   if c not in ['FLOOR','TALL_GRASS','WATER']:continue
+   rank=(10000 if c=='WATER' else 1000 if c=='TALL_GRASS' else 0)+abs(xx-target[0])+abs(yy-target[1])
+   candidates.append((rank,xx,yy,c))
+ assert candidates,(asm,'no traversable cell')
+ _,x,y,c=min(candidates)
+ m.update(x=x,y=y,collision=c,state='PLAYER_SURF' if c=='WATER' else 'PLAYER_NORMAL')
+ label=m['constant']
+ for a,b in replace.items():label=label.replace(a,b)
+ label=label.replace('_',' ')
+ m['label']=f"{m['id']:02} {label}"[:16]
+assert max(len(g['maps']) for g in groups)<=100
+lines=['; Generated by tools/generate_sandbox_maps.py. Debug-only.','SandboxAnyGroupTable:']
+for g in groups:lines.append(f"\tdw .Group{g['id']}")
+for g in groups:
+ lines.append(f".Group{g['id']}");lines.append(f"\tdb {len(g['maps'])}")
+ for m in g['maps']:lines.append(f"\tdb {m['id']}, {m['x']}, {m['y']}, {m['state']} ; {m['constant']}")
+lines+=['','SandboxAnyMapNamePointers:']
+for g in groups:lines.append(f"\tdw .Names{g['id']}")
+for g in groups:
+ lines.append(f".Names{g['id']}")
+ for m in g['maps']:lines.append(f'\tdb "{m["label"]}@"')
+lines+=['','SandboxAnyGroupNames:']
+for g,label in zip(groups,spanish):lines.append('\tdb "'+f'{g["id"]:02} {label}'[:16]+'@"')
+(P/'engine/debug/sandbox_any_map_data.asm').write_text('\n'.join(lines)+'\n',encoding='utf-8',newline='\n')
+# User-facing full catalog doubles as testable coordinate manifest.
+out=P.parent/'v4-sandbox-map-catalog.json'
+out.write_text(json.dumps({'groups':groups,'total_maps':len(flat),'maximum_group_size':max(len(g['maps']) for g in groups)},ensure_ascii=False,indent=2),encoding='utf-8')
+guide=['SANDBOX: CATÁLOGO COMPLETO DE MAPAS','',f'{len(flat)} mapas en 26 grupos. START > SANDBOX > VIAJAR > TODOS LOS MAPAS.','Elige primero grupo y después mapa. B cancela; las medallas y los eventos son independientes.','Cada destino se sitúa en una casilla transitable validada con bloques y colisiones originales,','fuera de puertas, escaleras, eventos de coordenadas y posiciones iniciales de NPC.','Las secuencias de historia y los mapas de conexión conservan sus reglas originales.','']
+for g,label in zip(groups,spanish):
+ guide+=[f"GRUPO {g['id']:02}: {label}"]
+ for m in g['maps']:guide.append(f"  {m['id']:02} {m['constant']} | {m['asm']} | x={m['x']} y={m['y']} | {m['collision']}")
+ guide.append('')
+(P.parent/'v4-sandbox-todos-los-mapas.txt').write_text('\n'.join(guide)+'\n',encoding='utf-8')
+print(json.dumps({'groups':len(groups),'maps':len(flat),'max_group':max(len(g['maps']) for g in groups),'water_only':sum(m['collision']=='WATER' for m in flat)},ensure_ascii=False))
diff --git a/tools/portable_randomizer.html b/tools/portable_randomizer.html
new file mode 100644
index 0000000..4d0f678
--- /dev/null
+++ b/tools/portable_randomizer.html
@@ -0,0 +1,41 @@
+<!doctype html><html lang="es"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Randomizador de Radical Cristal</title>
+<style>body{font:17px system-ui;color:#e6efff;background:#0d1424;max-width:780px;margin:60px auto;padding:0 24px;line-height:1.6}h1{line-height:1.15;font-size:36px}label{display:block;margin-top:25px;font-weight:700}input{display:block;width:100%;box-sizing:border-box;padding:13px;background:#18243a;border:1px solid #53729e;border-radius:8px;color:inherit;font:inherit}button{padding:13px 20px;margin:22px 10px 0 0;border:0;border-radius:8px;background:#91d5ff;color:#111d30;font:700 16px system-ui;cursor:pointer}button:disabled{opacity:.5}#status{white-space:pre-wrap;border-top:1px solid #405675;padding-top:20px}small{color:#b5c7e0}h2{font-size:22px;margin:30px 0 8px}table{border-collapse:collapse;width:100%;font-size:15px}td,th{border-top:1px solid #405675;padding:6px 8px;text-align:left;vertical-align:top}th{color:#91d5ff}code{color:#91d5ff}</style>
+<h1>Una aventura diferente<br>con tus mismas reglas</h1><p>Radical Cristal · Tito Xeluis · versión 5</p>
+<p>Genera otra distribución de Pokémon y MTs conservando los niveles, la dificultad, los eventos, las MOs y todas las reglas. Los movimientos de los Pokémon siguen siendo aleatorios durante el juego. El equipo final de Tito permanece fijo.</p>
+<label for="rom">1. Selecciona la ROM de esta versión</label><input id="rom" type="file" accept=".gbc,.gb"><small>Usa «Radical Cristal.gbc», o una copia generada con este randomizador.</small>
+<label for="seed">2. Escribe una semilla</label><input id="seed" maxlength="80"><small>La misma ROM y semilla producen la misma distribución. Comparte la semilla para compartir el reto.</small>
+<button id="new">Otra semilla</button><button id="generate">Generar y descargar ROM</button>
+<p>Empieza una partida nueva al cambiar de semilla. Los guardados pertenecen a su aventura; las ROMs generadas llevan la semilla en el nombre.</p>
+<p id="status">Todo funciona en tu navegador. La ROM se procesa en este equipo.</p>
+<div id="preview" hidden><h2>Vista previa de esta semilla</h2><div id="previewBody"></div></div>
+<script>/*__CORE__*/</script><script>
+const manifest=/*__MANIFEST__*/;
+const seed=document.querySelector('#seed'),status=document.querySelector('#status');
+function fresh(){const a=new Uint32Array(2);crypto.getRandomValues(a);seed.value=Array.from(a,n=>n.toString(16).padStart(8,'0')).join('');}
+document.querySelector('#new').onclick=fresh;fresh();
+function showPreview(r){
+ const sp=id=>manifest.speciesNames[id-1]||('#'+id),mv=id=>manifest.moveNames[id-1]||('#'+id);
+ const row=(a,b)=>'<tr><th>'+a+'</th><td>'+b+'</td></tr>';
+ let html='<table>'+row('Iniciales',r.starters.map(sp).join(', '));
+ for(const l of manifest.leaders)html+=row(l.name,l.keys.map(k=>sp(r.chosen[k]||0)).join(', '));
+ html+=row('MT01–MT50',r.tms.map(mv).join(', '))+'</table><small>Solo cambian las especies y las MT; niveles, MO y reglas se conservan.</small>';
+ document.querySelector('#previewBody').innerHTML=html;document.querySelector('#preview').hidden=false;
+}
+document.querySelector('#generate').onclick=async function(){
+ this.disabled=true;
+ try{
+  const file=document.querySelector('#rom').files[0];if(!file)throw Error('Selecciona primero la ROM.');
+  status.textContent='Comprobando versión y generando aventura…';
+  const bytes=new Uint8Array(await file.arrayBuffer());
+  if(bytes.length!==manifest.length)throw Error('La ROM no corresponde a esta versión.');
+  const masked=CristalRandomizer.masked(bytes,manifest);
+  const digest=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',masked)),x=>x.toString(16).padStart(2,'0')).join('');
+  if(digest!==manifest.immutableSHA256)throw Error('Esta ROM no es compatible con el randomizador v4. Usa la ROM incluida junto a esta herramienta.');
+  const result=CristalRandomizer.randomize(bytes,manifest,seed.value.trim());
+  const name='Radical-Cristal-'+seed.value.replace(/[^a-zA-Z0-9_-]/g,'_').slice(0,50)+'.gbc';
+  const url=URL.createObjectURL(new Blob([result.bytes],{type:'application/octet-stream'}));const a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),30000);
+  showPreview(result);
+  status.textContent='ROM generada: '+name+'\nSemilla: '+result.seed+'\n'+result.sites+' referencias de Pokémon y 50 MTs aleatorizadas.\nAbre el archivo descargado en el emulador y comienza una partida nueva.';
+ }catch(e){status.textContent=e.message;}finally{this.disabled=false;}
+};
+</script></html>
diff --git a/tools/portable_randomizer.js b/tools/portable_randomizer.js
new file mode 100644
index 0000000..2f07339
--- /dev/null
+++ b/tools/portable_randomizer.js
@@ -0,0 +1,51 @@
+/* Pure offline reseeding core. The manifest exposes operands, never executable code. */
+(function(root){
+ 'use strict';
+ function rng(seed){
+  let x=2166136261;for(const c of String(seed)){x^=c.charCodeAt(0);x=Math.imul(x,16777619)>>>0;}
+  if(!x)x=0x9e3779b9;
+  return n=>{x^=x<<13;x^=x>>>17;x^=x<<5;return (x>>>0)%n;};
+ }
+ function shuffled(values,roll){
+  const a=values.slice();for(let i=a.length-1;i>0;i--){const j=roll(i+1);[a[i],a[j]]=[a[j],a[i]];}return a;
+ }
+ function masked(bytes,m){
+  const b=Uint8Array.from(bytes);for(const [a,n] of m.mutable)b.fill(0,a,a+n);return b;
+ }
+ function randomize(bytes,m,seed){
+  if(bytes.length!==m.length)throw Error('El tamaño no corresponde a esta versión del juego.');
+  if(!String(seed).trim())throw Error('Introduce una semilla.');
+  const b=Uint8Array.from(bytes),roll=rng(seed),starters=new Set(),chosen={};
+  for(const group of m.groups){
+   let pool=m.pools[group.pool];
+   if(group.kind==='starter')pool=pool.filter(x=>!starters.has(x));
+   if(pool.length>1)pool=pool.filter(x=>x!==group.original);
+   const mon=pool[roll(pool.length)];chosen[group.key]=mon;
+   if(group.kind==='starter')starters.add(mon);
+   for(const address of group.sites)b[address]=mon;
+  }
+  const tms=shuffled(m.moves,roll).slice(0,50);b.set(tms,m.tm);
+  for(let i=0;i<m.trades.length;i++){
+   const pool=shuffled(m.trades[i],roll);
+   for(let j=0;j<8;j++)b[m.tradeOffset+i*8+j]=pool[j%pool.length];
+  }
+  function big(address,n,length){for(let i=length-1;i>=0;i--){b[address+i]=n&255;n>>>=8;}}
+  for(let i=0;i<20;i++){
+   const address=m.eggs.offset+i*m.eggs.stride;
+   const pool=m.pools.egg,mon=pool[roll(pool.length)],s=m.stats[mon];
+   b[address]=mon;
+   const dv0=b[address+m.eggs.dv],dv1=b[address+m.eggs.dv+1];
+   const atk=dv0>>4,def=dv0&15,speed=dv1>>4,special=dv1&15;
+   const hp=((atk&1)<<3)|((def&1)<<2)|((speed&1)<<1)|(special&1);
+   const dvs=[hp,atk,def,speed,special,special];
+   for(let j=0;j<6;j++)big(address+m.eggs.stats+2*j,Math.floor((s.base[j]+dvs[j])*10/100)+(j===0?15:5),2);
+   big(address+m.eggs.exp,s.exp5,3);
+  }
+  // Cartridge global checksum excludes its own two bytes; no gameplay bytes change.
+  let sum=0;for(let i=0;i<b.length;i++)if(i!==0x14e&&i!==0x14f)sum=(sum+b[i])&65535;
+  b[0x14e]=sum>>8;b[0x14f]=sum&255;
+  return {bytes:b,seed:String(seed),starters:m.groups.filter(g=>g.kind==='starter').map(g=>chosen[g.key]),sites:m.groups.reduce((n,g)=>n+g.sites.length,0),tms,chosen};
+ }
+ const api={randomize,masked,rng};
+ if(typeof module!=='undefined')module.exports=api;else root.CristalRandomizer=api;
+})(typeof globalThis!=='undefined'?globalThis:this);
diff --git a/tools/prepare_portable_randomizer.py b/tools/prepare_portable_randomizer.py
new file mode 100644
index 0000000..2ffaf7c
--- /dev/null
+++ b/tools/prepare_portable_randomizer.py
@@ -0,0 +1,91 @@
+"""Add zero-byte local labels for safe offline ROM reseeding (run once per source).
+
+Unlike balanced_randomizer.py, this never restores or regenerates gameplay code.
+Only named randomizable operands are exposed to the external patcher.
+"""
+from pathlib import Path
+import json,re
+
+ROOT=Path(__file__).resolve().parents[1]
+species=re.findall(r'^\s*const ([A-Z][A-Z0-9_]+)\s*(?:;[^\n]*)?$',(ROOT/'constants/pokemon_constants.asm').read_text(encoding='utf8'),re.M)[:251]
+ids={s:i+1 for i,s in enumerate(species)}
+sites=[];counter=0
+def label(line,mon,level,offset=1,group=None,kind='wild',**extra):
+ global counter
+ key=f'__RZ{counter:04d}';counter+=1
+ sites.append(dict(label=key,mon=mon,level=level,offset=offset,group=group or key,kind=kind,**extra))
+ return f'.{key}:\n'+line
+def convert(path,fn):
+ p=ROOT/path;s=p.read_text(encoding='utf8')
+ s=re.sub(r'^\.__RZ\d+:\n','',s,flags=re.M)
+ p.write_text(fn(s),encoding='utf8',newline='\n')
+
+for path in sorted((ROOT/'data/wild').glob('*.asm')):
+ def wild(s,path=path):
+  out=[]
+  for line in s.splitlines():
+   content=line.split(';')[0]
+   m=re.match(r'\s*db\s+(\d+),\s*([A-Z][A-Z0-9_]+)\s*$',content)
+   if m and m[2] in ids:
+    line=label(line,m[2],int(m[1]))
+   elif path.stem in ('fish','treemons','bug_contest_mons'):
+    m=re.match(r'\s*db\s+([^,]+),\s*([A-Z][A-Z0-9_]+),\s*(\d+)',content)
+    t=re.match(r'\s*db\s+([A-Z][A-Z0-9_]+),\s*(\d+),\s*([A-Z][A-Z0-9_]+),\s*(\d+)',content)
+    if t and t[1] in ids and t[3] in ids:
+     key=f'__RZ{counter:04d}'
+     line=label(line,t[1],int(t[2]),offset=0)
+     sites.append(dict(label=key,mon=t[3],level=int(t[4]),offset=2,group=key+'b',kind='wild'))
+    elif m and m[2] in ids:
+     line=label(line,m[2],int(m[3]))
+   out.append(line)
+  return '\n'.join(out)+'\n'
+ convert(path.relative_to(ROOT),wild)
+
+def trainers(s):
+ out=[];group=''
+ for line in s.splitlines():
+  m=re.match(r'^(\w+)Group:',line)
+  if m:group=m[1]
+  m=re.match(r'\s*db\s+(\d+),\s*([A-Z][A-Z0-9_]+)\b',line)
+  if m and m[2] in ids and group!='TitoXeluis':
+   line=label(line,m[2],int(m[1]),kind='trainer')
+  out.append(line)
+ return '\n'.join(out)+'\n'
+convert('data/trainers/parties.asm',trainers)
+
+for p in sorted((ROOT/'maps').glob('*.asm')):
+ def maps(s,p=p):
+  encounters={}
+  for cmd,mon,lvl in re.findall(r'^\s*(givepoke|giveegg|loadwildmon) ([A-Z][A-Z0-9_]+), (\d+|EGG_LEVEL)',s,re.M):
+   if mon in ids:encounters[mon]=(int(lvl) if lvl.isdigit() else 5,'starter' if p.stem=='ElmsLab' else 'event' if cmd=='loadwildmon' else 'gift')
+  out=[]
+  for line in s.splitlines():
+   m=re.match(r'\s*(givepoke|giveegg|loadwildmon|pokepic|cry) ([A-Z][A-Z0-9_]+)\b',line)
+   n=re.match(r'\s*getmonname STRING_BUFFER_\d, ([A-Z][A-Z0-9_]+)\b',line)
+   mon=m[2] if m else n[1] if n else None
+   if mon in encounters:
+    lvl,kind=encounters[mon]
+    line=label(line,mon,lvl,kind=kind,group=p.stem+':'+mon)
+   out.append(line)
+  return '\n'.join(out)+'\n'
+ convert(p.relative_to(ROOT),maps)
+
+def shuckle(s):
+ old=re.search(r'ld a, (\w+)\n\s*ld \[wCurPartySpecies\]',s)[1]
+ return re.sub(r'^(\s*(?:ld a,|cp) '+old+r'\s*)$',lambda m:label(m[0],old,19,group='shuckle-gift',kind='gift'),s,flags=re.M)
+convert('engine/events/shuckle.asm',shuckle)
+def roam(s):
+ start=s.index('InitRoamMons:');end=s.index('CheckEncounterRoamMon:')
+ chunk=s[start:end]
+ def row(m):return label(m[1],m[2],48,kind='event',group='roam:'+m[2])+'\n'+m[3]
+ chunk=re.sub(r'(\tld a, (\w+))\n(\tld \[wRoamMon[12]Species\], a)',row,chunk)
+ return s[:start]+chunk+s[end:]
+convert('engine/overworld/wildmons.asm',roam)
+def tower(s):
+ roamers=[x for x in sites if x['group'].startswith('roam:')]
+ for x in roamers:
+  s=re.sub(r'^(\s*setval '+x['mon']+r')\s*$',lambda m,x=x:label(m[1],x['mon'],48,kind='event',group=x['group']),s,flags=re.M)
+ return s
+convert('maps/TinTower1F.asm',tower)
+(ROOT/'data/events/portable_randomizer_sites.json').write_text(json.dumps(sites,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
+print('Exposed safe reseeding sites:',len(sites))
