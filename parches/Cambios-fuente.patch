+	text "¡Vaya, vaya!"
+	line "¿Tú otra vez?"
+
+	para "Aquí no hay"
+	line "medallas ni topes."
+	cont "Sólo nivel 100."
+
+	para "Te voy a demostrar"
+	line "quién es el mejor"
+	cont "entrenador de"
+	cont "KANTO."
+
+	para "¡Adelante!"
+	done
