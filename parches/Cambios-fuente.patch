+++ b/engine/events/tito_xeluis.asm
@@ -0,0 +1,734 @@
+SECTION "Tito Xeluis services", ROMX
+
+TitoXeluisServices::
+	ld hl, .Hello
+	call PrintText
+
+.again
+	xor a
+	ld [wScriptVar], a
+	ld hl, .MenuPrompt
+	call PrintText
+	ld hl, .MenuHeader
+	call LoadMenuHeader
+.WaitMainMenu
+	call VerticalMenu
+	call ExitMenu
+	ret c
+	ld a, [wMenuCursorY]
+	cp 1
+	jr z, .trade
+	cp 2
+	jr z, .caps
+	cp 3
+	jr z, .reminder
+	cp 4
+	jr z, .battle
+	cp 5
+	jr z, .more
+	ret
+.more
+	ld hl, .MoreMenuHeader
+	call LoadMenuHeader
+	call VerticalMenu
+	call ExitMenu
+	jp c, .again
+	ld a, [wMenuCursorY]
+	cp 1
+	jr z, .evolution
+	cp 2
+	jr z, .superleague
+	cp 3
+	jp z, .again
+	ret
+.superleague
+	ld a, 2
+	ld [wScriptVar], a
+	ret
+.evolution
+	farcall TitoEvolutionGuide
+	jp .again
+.battle
+	ld a, 1
+	ld [wScriptVar], a
+	ret
+.trade
+	call TitoCanTrade
+	jr nz, .trade_ok
+	ld hl, .UsedTrade
+	call PrintText
+	jp .again
+.trade_ok
+	ld hl, .TradeText
+	call PrintText
+	farcall TitoXeluisTrade
+	jp .again
+.caps
+	farcall GetCurrentLevelCap
+	ld a, b
+	ld [wTitoCurrentCap], a
+	ld hl, .CapText
+	call PrintText
+	jp .again
+.reminder
+	call TitoMoveReminder
+	jp .again
+.MenuHeader:
+	db MENU_BACKUP_TILES
+	menu_coords 0, 0, 19, 11
+	dw .MenuData
+	db 1
+.MenuData:
+	db STATICMENU_CURSOR
+	db 5
+	db "INTERCAMBIAR@"
+	db "LÍMITES DE NIVEL@"
+	db "RECORDAR ATAQUES@"
+	db "COMBATIR@"
+	db "MÁS / SALIR@"
+.MoreMenuHeader:
+	db MENU_BACKUP_TILES
+	menu_coords 0, 0, 19, 9
+	dw .MoreMenuData
+	db 1
+.MoreMenuData:
+	db STATICMENU_CURSOR
+	db 4
+	db "EVOLUCIONES@"
+	db "SUPERLIGA@"
+	db "VOLVER@"
+	db "SALIR@"
+.Hello:
