+	line "intercambiado."
+	para "Si me ganas tras"
+	line "vencer a ROJO,"
+	cont "serán ilimitados."
+	done
+.TradeText:
+	text "Dame un #MON"
+	line "vivo. Recibirás"
+	cont "otro comparable."
+	para "Elige uno para ver"
+	line "mi propuesta."
+	done
+.CapText:
+	text "Tu límite actual:"
+	line "nivel @"
+	text_decimal wTitoCurrentCap, 1, 3
+	text "."
+	para "Al alcanzarlo,"
+	line "ganas 0 EXP."
+	para "JOHTO:"
+	line "PEGASO 19"
+	cont "ANTÓN 24"
+	cont "BLANCA 29"
+	cont "MORTI 35"
+	cont "ANÍBAL 40"
+	cont "YASMINA 44"
+	cont "FREDO 48"
+	cont "DÉBORA 53"
+	para "LIGA: 65"
+	para "KANTO:"
+	line "LT. SURGE 67"
+	cont "SABRINA 70"
+	cont "ERIKA 73"
+	cont "SACHIKO 75"
+	cont "MISTY 77"
+	cont "BROCK 80"
+	cont "BLAINE 83"
+	cont "AZUL 85"
+	para "Con 16 medallas:"
+	line "ROJO al nivel 95."
+	para "Si vences a ROJO:"
+	line "límite 100."
+	done
+
+TitoMoveReminder:
+	ld hl, .ChooseMon
+	call PrintText
+	ld b, PARTYMENUACTION_GIVE_MON
+	farcall SelectTradeOrDayCareMon
+	ret c
+	ld a, [wCurPartySpecies]
+	cp EGG
+	jr z, .invalid
+	call TitoBuildReminderMoves
+	ld a, [wTitoReminderMoves]
+	and a
+	jr z, .none
+	; The party picker has returned to the live map. Enter a real submenu before
+	; drawing text or LearnMove: otherwise overworld OAM sits on the move list,
+	; and LearnMove restores map tiles with the menu's attribute palettes.
+	call FadeToMenu
+	call ClearBGPalettes
+	call ClearScreen
+	call DelayFrame
+	ld b, SCGB_DIPLOMA
+	call GetSGBLayout
+	call SetDefaultBGPAndOBP
+	ld hl, .ChooseMove
+	call PrintText
+	ld hl, .MenuHeader
+	call LoadMenuHeader
+	xor a
+	ld [wMenuScrollPosition], a
+	ld [wWhichIndexSet], a
+	inc a
+	ld [wMenuCursorPosition], a
+	call InitScrollingMenu
+	call ScrollingMenu
+	call ExitMenu
+	ld a, [wMenuJoypad]
+	cp PAD_B
+	jr z, .close
+	ld a, [wMenuSelection]
+	cp -1
+	jr z, .close
+	ld [wPutativeTMHMMove], a
+	ld [wNamedObjectIndex], a
+	call GetMoveName
+	call CopyName1
+	predef LearnMove
+.close
+	; FadeToMenu backed up the overworld tilemap. This restores both tile and
+	; attribute maps, palettes, NPC graphics and sprite update state together.
+	jp CloseSubmenu
+.invalid
+	ld hl, .EggText
+	jp PrintText
+.none
+	ld hl, .NoMoves
+	jp PrintText
+.ChooseMon:
+	text "¿Quién necesita"
+	line "recordar ataques?"
+	done
+.ChooseMove:
+	text "Elige un ataque"
+	line "original de nivel."
+	done
+.EggText:
+	text "Un HUEVO aún no"
+	line "puede aprender."
+	done
+.NoMoves:
+	text "Ya conoce todos"
+	line "sus ataques de"
+	cont "este nivel."
+	done
+.MenuHeader:
+	db MENU_BACKUP_TILES
+	menu_coords 1, 1, 18, 11
+	dw .MenuData
+	db 1
+.MenuData:
+	db SCROLLINGMENU_DISPLAY_ARROWS
+	db 5, 0
+	db SCROLLINGMENU_ITEMS_NORMAL
+	dbw 0, wTitoReminderMoves
+	dba .PrintMove
+	dba NULL
+	dba NULL
+.PrintMove:
+	push de
+	ld a, [wMenuSelection]
+	ld [wNamedObjectIndex], a
+	call GetMoveName
+	ld de, wStringBuffer1
+	pop hl
+	jp PlaceString
+
+TitoBuildReminderMoves::
+; Only original moves at/below the selected mon's current level, excluding
+; moves already known. Random starting moves never overwrite these tables.
+	ld hl, wPartyMon1Level
+	ld bc, PARTYMON_STRUCT_LENGTH
+	ld a, [wCurPartyMon]
+	call AddNTimes
+	ld a, [hl]
+	ld [wCurPartyLevel], a
+	xor a
+	ld [wTitoReminderMoves], a
+	ld a, [wCurPartySpecies]
+	dec a
+	ld l, a
+	ld h, 0
+	add hl, hl
+	ld de, EvosAttacksPointers
+	add hl, de
+	ld a, BANK(EvosAttacksPointers)
+	call GetFarWord
+.skip_evos
+	ld a, BANK(EvosAttacksPointers)
+	call GetFarByte
+	inc hl
+	and a
+	jr nz, .skip_evos
+.next
+	ld a, BANK(EvosAttacksPointers)
+	call GetFarByte
+	inc hl
+	and a
+	jr z, .done
+	ld b, a
+	ld a, [wCurPartyLevel]
+	cp b
+	jr c, .done
+	ld a, BANK(EvosAttacksPointers)
+	call GetFarByte
+	inc hl
+	push hl
+	ld d, a
+	ld hl, wPartyMon1Moves
+	ld bc, PARTYMON_STRUCT_LENGTH
+	ld a, [wCurPartyMon]
+	call AddNTimes
+	ld b, NUM_MOVES
+.known
+	ld a, [hli]
+	cp d
+	jr z, .skip
+	dec b
+	jr nz, .known
+	ld a, [wTitoReminderMoves]
+	ld b, a
+	ld hl, wTitoReminderMoves + 1
+	and a
+	jr z, .append
+.duplicate
+	ld a, [hli]
+	cp d
+	jr z, .skip
+	dec b
+	jr nz, .duplicate
+.append
+	ld a, [wTitoReminderMoves]
+	cp 30
+	jr nc, .skip
+	inc a
+	ld [wTitoReminderMoves], a
+	ld c, a
+	ld b, 0
+	ld hl, wTitoReminderMoves
+	add hl, bc
+	ld [hl], d
+.skip
+	pop hl
+	jr .next
+.done
+	ld a, [wTitoReminderMoves]
+	inc a
+	ld c, a
+	ld b, 0
+	ld hl, wTitoReminderMoves
+	add hl, bc
+	ld [hl], -1
+	ret
+
+TitoHasAllBadges::
+	ld a, [wJohtoBadges]
+	cp $ff
+	jr nz, .missing
+	ld a, [wKantoBadges]
+	cp $ff
+	jr nz, .missing
+	ld a, 1
+	ld [wScriptVar], a
+	ret
+.missing
+	xor a
+	ld [wScriptVar], a
+	ret
+
+TitoCityTradeFlag::
+	ld a, [wMapGroup]
+	ld b, a
+	ld a, [wMapNumber]
+	ld c, a
+	call GetWorldMapLocation
+	ld e, a
+	ld d, 0
+	ld hl, EVENT_TITO_TRADE_BASE
+	add hl, de
+	ld d, h
+	ld e, l
+	ret
+
+TitoCanTrade::
+; NZ means allowed. Flags use existing saved event space, preserving v2 saves.
+	ld de, EVENT_BEAT_TITO_XELUIS
+	ld b, CHECK_FLAG
+	call EventFlagAction
+	ret nz
+	call TitoCityTradeFlag
+	ld b, CHECK_FLAG
+	call EventFlagAction
+	jr nz, .blocked
+	ld a, 1
+	and a
+	ret
+.blocked
+	xor a
+	ret
+
+TitoMarkTradeUsed::
+; Called only after DoNPCTrade has completed, never on cancel/invalid choice.
+	call TitoCityTradeFlag
+	ld b, SET_FLAG
+	jp EventFlagAction
+
+TitoCanChallenge::
+	ld de, EVENT_BEAT_RED_PERMANENT
+	ld b, CHECK_FLAG
+	call EventFlagAction
+	jr nz, .yes
+; Migrate an existing v2 save where Red has disappeared after his defeat.
+; His visibility flag is initially set, so require Hall of Fame + all badges.
+	ld a, [wStatusFlags]
+	bit STATUSFLAGS_HALL_OF_FAME_F, a
+	jr z, .no
+	ld a, [wJohtoBadges]
+	cp $ff
+	jr nz, .no
+	ld a, [wKantoBadges]
+	cp $ff
+	jr nz, .no
+	ld de, EVENT_RED_IN_MT_SILVER
+	ld b, CHECK_FLAG
+	call EventFlagAction
+	jr z, .no
+	ld de, EVENT_BEAT_RED_PERMANENT
+	ld b, SET_FLAG
+	call EventFlagAction
+.yes
+	ld a, 1
+	ld [wScriptVar], a
+	ret
+.no
+	xor a
+	ld [wScriptVar], a
+	ret
+
