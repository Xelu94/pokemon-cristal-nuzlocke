+; Debug-only complete map picker. No symbols/data enter the normal ROM.
+SECTION "Sandbox all maps", ROMX
+
+SandboxChooseAnyMap::
+.group
+	call ClearTilemap
+	ld hl, .GroupsHeader
+	call LoadMenuHeader
+	call .ResetCursor
+	call InitScrollingMenu
+	call ScrollingMenu
+	call ExitMenu
+	ld a, [wMenuJoypad]
+	cp PAD_B
+	ret z
+	ld a, [wMenuSelection]
+	cp -1
+	ret z
+	ld [wSandboxGenericGroup], a
+	call SandboxBuildAnyMapList
+.map
+	call ClearTilemap
+	ld hl, .MapsHeader
+	call LoadMenuHeader
+	call .ResetCursor
+	call InitScrollingMenu
+	call ScrollingMenu
+	call ExitMenu
+	ld a, [wMenuJoypad]
+	cp PAD_B
+	jr z, .group
+	ld a, [wMenuSelection]
+	cp -1
+	jr z, .group
+	ld [wSandboxGenericMap], a
+	call SandboxFindGenericCoordinates
+	ld a, 1
+	ld [wSandboxUseGeneric], a
+	ld [wSandboxWarpPending], a
+	ret
+.ResetCursor
+	xor a
+	ld [wMenuScrollPosition], a
+	ld [wWhichIndexSet], a
+	inc a
+	ld [wMenuCursorPosition], a
+	ret
+.GroupsHeader
+	db MENU_BACKUP_TILES
+	menu_coords 1, 1, 18, 16
+	dw .GroupsData
+	db 1
+.GroupsData
+	db SCROLLINGMENU_DISPLAY_ARROWS
+	db 8, 0
+	db SCROLLINGMENU_ITEMS_NORMAL
+	dba .GroupList
+	dba SandboxPrintGenericGroup
+	dba NULL
+	dba NULL
+.GroupList
+	db NUM_MAP_GROUPS
+	for n, 1, NUM_MAP_GROUPS + 1
+		db n
+	endr
+	db -1
+.MapsHeader
+	db MENU_BACKUP_TILES
+	menu_coords 1, 1, 18, 16
+	dw .MapsData
+	db 1
+.MapsData
+	db SCROLLINGMENU_DISPLAY_ARROWS
+	db 8, 0
+	db SCROLLINGMENU_ITEMS_NORMAL
+	dbw 0, wFilteredNumItems
+	dba SandboxPrintGenericMap
+	dba NULL
+	dba NULL
+
+SandboxPrintGenericGroup:
+	push de
+	ld a, [wMenuSelection]
+	cp -1
+	jr z, .cancel
+	dec a
+	ld hl, SandboxAnyGroupNames
+	call GetNthString
+	ld d, h
+	ld e, l
+	jr .print
+.cancel
+	ld de, .Cancel
+.print
+	pop hl
+	jp PlaceString
+.Cancel db "VOLVER@"
+
+SandboxPrintGenericMap:
+	push de
+	ld a, [wMenuSelection]
+	cp -1
+	jr z, .cancel
+	ld a, [wSandboxGenericGroup]
+	dec a
+	ld e, a
+	ld d, 0
+	ld hl, SandboxAnyMapNamePointers
+	add hl, de
+	add hl, de
+	ld a, [hli]
+	ld h, [hl]
+	ld l, a
+	ld a, [wMenuSelection]
+	dec a
+	call GetNthString
+	ld d, h
+	ld e, l
+	jr .print
+.cancel
+	ld de, .Cancel
+.print
+	pop hl
+	jp PlaceString
+.Cancel db "VOLVER@"
+
+SandboxAnyGroupPointer::
+	ld a, [wSandboxGenericGroup]
+	dec a
+	ld e, a
+	ld d, 0
+	ld hl, SandboxAnyGroupTable
+	add hl, de
+	add hl, de
+	ld a, [hli]
+	ld h, [hl]
+	ld l, a
+	ret
+
+SandboxBuildAnyMapList::
+	call SandboxAnyGroupPointer
+	ld a, [hl]
+	ld [wFilteredNumItems], a
+	ld b, a
+	ld c, 1
+	ld de, wFilteredItems
+.loop
+	ld a, c
+	ld [de], a
+	inc de
+	inc c
+	dec b
+	jr nz, .loop
+	ld a, -1
+	ld [de], a
+	ret
+
+SandboxFindGenericCoordinates::
+	call SandboxAnyGroupPointer
+	inc hl
+	ld a, [wSandboxGenericMap]
+	dec a
+	ld e, a
+	ld d, 0
+	add hl, de
+	add hl, de
+	add hl, de
+	add hl, de
+	inc hl ; record = map, x, y, player state
+	ld a, [hli]
+	ld [wSandboxGenericX], a
+	ld a, [hli]
+	ld [wSandboxGenericY], a
+	ld a, [hl]
+	ld [wSandboxGenericState], a
+	ret
+
+SandboxApplyGenericWarp::
+; Mirror native Script_warp with selected RAM group/map/coordinates.
+	ld a, [wSandboxGenericGroup]
+	ld [wMapGroup], a
+	ld a, [wSandboxGenericMap]
+	ld [wMapNumber], a
+	ld a, [wSandboxGenericX]
+	ld [wXCoord], a
+	ld a, [wSandboxGenericY]
+	ld [wYCoord], a
+	ld a, [wSandboxGenericState]
+	ld [wPlayerState], a
+	ld a, SPAWN_N_A
+	ld [wDefaultSpawnpoint], a
+	ld a, MAPSETUP_WARP
+	ldh [hMapEntryMethod], a
+	ld a, MAPSTATUS_ENTER
+	call LoadMapStatus
+	farcall StopScript
+	ret
+
