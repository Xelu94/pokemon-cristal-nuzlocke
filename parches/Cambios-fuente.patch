+++ b/engine/events/v4_world.asm
@@ -0,0 +1,502 @@
+PUSHS
+SECTION "V4 world quality of life", ROMX
+
+; Choose only the 50 actual TM item IDs, skipping the two holes.
+ChooseRandomTM::
+	ld a, NUM_TMS
+	call RandomRange
+	add TM01
+	cp ITEM_C3
+	jr c, .done
+	inc a
+	cp ITEM_DC
+	jr c, .done
+	inc a
+.done
+	ld b, a
+	ret
+
+ReceiveRandomTM::
+; Pick a random starting TM, then skip saturated stacks. Failure is atomic:
+; mother does not charge money, and the Goldenrod mail gift refunds the mail.
+	call ChooseRandomTM
+	ld c, b
+	farcall GetTMHMNumber
+	dec c
+	ld e, c
+	ld d, 0
+	ld hl, wTMsHMs
+	add hl, de
+	ld b, NUM_TMS
+.scan
+	ld a, [hl]
+	cp MAX_ITEM_STACK
+	jr c, .available
+	inc hl
+	inc e
+	ld a, e
+	cp NUM_TMS
+	jr c, .next
+	ld e, 0
+	ld hl, wTMsHMs
+.next
+	dec b
+	jr nz, .scan
+	xor a
+	ld [wScriptVar], a
+	ret
+.available
+	ld a, e
+	add TM01
+	cp ITEM_C3
+	jr c, .item
+	inc a
+	cp ITEM_DC
+	jr c, .item
+	inc a
+.item
+	ld [wCurItem], a
+	ld a, 1
+	ld [wItemQuantityChange], a
+	ld hl, wNumItems
+	call ReceiveItem
+	ld a, 0
+	jr nc, .result
+	inc a
+.result
+	ld [wScriptVar], a
+	and a
+	ret z
+	scf
+	ret
+
+; B=item, preserving every non-revive item. All found revive forms become TMs.
+ReplaceFoundRevive::
+	ld a, b
+	cp REVIVE
+	jr z, ChooseRandomTM
+	cp MAX_REVIVE
+	jr z, ChooseRandomTM
+	cp REVIVAL_HERB
+	jr z, ChooseRandomTM
+	ret
+
+; Return the previous contiguous leader/league ace -3 (zero before Falkner).
+; Badges may be earned out of order: only completed progression stages count.
+GetProgressionLevelFloor::
+	ld hl, .JohtoCaps
+	ld a, [wJohtoBadges]
+	ld b, a
+	ld c, 0
+.johto
+	ld a, [hli]
+	and a
+	jr z, .league
+	and b
+	jr z, .done
+	ld c, [hl]
+	inc hl
+	jr .johto
+.league
+	ld a, [wStatusFlags]
+	bit STATUSFLAGS_HALL_OF_FAME_F, a
+	jr z, .done
+	ld c, 65
+	ld hl, .KantoCaps
+	ld a, [wKantoBadges]
+	ld b, a
+.kanto
+	ld a, [hli]
+	and a
+	jr z, .done
+	and b
+	jr z, .done
+	ld c, [hl]
+	inc hl
+	jr .kanto
+.done
+	ld a, c
+	and a
+	ret z
+	sub 3
+	ret
+
+.JohtoCaps
+	db 1 << ZEPHYRBADGE,19,1 << HIVEBADGE,24,1 << PLAINBADGE,29
+	db 1 << FOGBADGE,35,1 << STORMBADGE,40,1 << MINERALBADGE,44
+	db 1 << GLACIERBADGE,48,1 << RISINGBADGE,53,0
+.KantoCaps
+	db 1 << THUNDERBADGE,67,1 << MARSHBADGE,70,1 << RAINBOWBADGE,73
+	db 1 << SOULBADGE,75,1 << CASCADEBADGE,77,1 << BOULDERBADGE,80
+	db 1 << VOLCANOBADGE,83,1 << EARTHBADGE,85,0
+
+; B=input/output level. Preserve C/DE/HL for all trainer record formats.
+ClampProgressionLevel::
+; The first Route 31 Ulex uses a softened level while his party is read.
+	ld a, [wUlexLocation]
+	bit 7, a
+	jr z, .not_soft
+	ld b, ULEX_ROUTE_31_FIRST_LEVEL
+	ret
+.not_soft
+; Initial routes retain the original opening levels on later visits.
+	ld a, [wMapGroup]
+	cp GROUP_ROUTE_29
+	jr nz, .not29
+	ld a, [wMapNumber]
+	cp MAP_ROUTE_29
+	ret z
+.not29
+	ld a, [wMapGroup]
+	cp GROUP_ROUTE_30
+	jr nz, .not30
+	ld a, [wMapNumber]
+	cp MAP_ROUTE_30
+	ret z
+.not30
+	ld a, [wMapGroup]
+	cp GROUP_ROUTE_31
+	jr nz, .clamp
+	ld a, [wMapNumber]
+	cp MAP_ROUTE_31
+	ret z
+.clamp
+	push hl
+	push de
+	push bc
+	call GetProgressionLevelFloor
+	pop bc
+	cp b
+	jr c, .done
+	ld b, a
+.done
+	pop de
+	pop hl
+	ret
+
+ApplyWildProgressionFloor::
+; Event encounter levels are authored separately (e.g. shrine25); keep them.
+	ld a, [wBattleScriptFlags]
+	bit 7, a
+	ret nz
+	ld a, [wBattleType]
+	cp BATTLETYPE_TUTORIAL
+	ret z
+	ld a, [wCurPartyLevel]
+	ld b, a
+	call ClampProgressionLevel
+	ld a, b
+	ld [wCurPartyLevel], a
+	ret
+
+; Only legacy inventory changes within the same serialized footprint.
+; BC=version byte, DE=already-open primary or backup sPlayerData.
+; Every old bag/PC stack survives, including 999 candy/ball stacks.
+MigrateV3Inventory::
+	ld h, b
+	ld l, c
+	ld a, [hl]
+	cp $b4
+	ret z
+	push de
+	ld hl, wNumItems - wPlayerData
+	add hl, de
+	ld de, wNumItems
+	ld bc, LEGACY_MAX_ITEMS * 2 + 2
+	call CopyBytes
+	pop de
+	push de
+	ld hl, wNumKeyItems - wPlayerData - V4_INVENTORY_SHIFT
+	add hl, de
+	ld de, wNumKeyItems
+	ld bc, MAX_KEY_ITEMS + 2
+	call CopyBytes
+	pop de
+	push de
+	ld hl, wNumBalls - wPlayerData - V4_INVENTORY_SHIFT
+	add hl, de
+	ld de, wNumBalls
+	ld bc, MAX_BALLS * 2 + 2
+	call CopyBytes
+	pop de
+	push de
+	ld hl, wNumPCItems - wPlayerData - V4_INVENTORY_SHIFT
+	add hl, de
+	ld de, wNumPCItems
+	ld bc, MAX_PC_ITEMS * 2 + 2
+	call CopyBytes
+	ld a, [wNumPCItems]
+	cp MAX_PC_ITEMS + 1
+	jr nc, .overflow
+; The copied list includes its terminator when old PC count <=20.
+	pop de
+	ret
+.overflow
+	sub MAX_PC_ITEMS
+	ld b, a ; count of old PC stacks that no longer fit in PC
+	ld a, [wNumItems]
+	ld c, a
+	add b
+	ld [wNumItems], a
+	ld a, MAX_PC_ITEMS
+	ld [wNumPCItems], a
+	ld a, -1
+	ld [wPCItems + MAX_PC_ITEMS * 2], a
+	pop de
+	ld hl, wNumPCItems - wPlayerData - V4_INVENTORY_SHIFT + 1 + MAX_PC_ITEMS * 2
+	add hl, de
+	push hl
+	ld hl, wItems
+	ld e, c
+	ld d, 0
+	add hl, de
+	add hl, de
+	ld d, h
+	ld e, l
+	pop hl
+	ld c, b
+	ld b, 0
+	sla c
+	call CopyBytes
+	ld a, -1
+	ld [de], a
+	ret
+
+DEF wReplacementRepelItem EQUS "wUnusedMapBuffer + 1"
+DEF wReplacementRepelSteps EQUS "wUnusedMapBuffer + 2"
+
+FindReplacementRepel::
+	ld hl, .Repels
+.loop
+	ld a, [hli]
+	and a
+	jr z, .none
+	ld [wCurItem], a
+	ld [wReplacementRepelItem], a
+	ld a, [hli]
+	ld [wReplacementRepelSteps], a
+	push hl
+	ld hl, wNumItems
+	call CheckItem
+	pop hl
+	jr nc, .loop
+	ld a, [wCurItem]
+	ld [wNamedObjectIndex], a
+	call GetItemName
+	ld a, 1
+	ld [wScriptVar], a
+	ret
+.none
+	xor a
+	ld [wScriptVar], a
+	ret
+.Repels
+	db MAX_REPEL, 250, SUPER_REPEL, 200, REPEL, 100, 0
+
+UseReplacementRepel::
+	ld a, [wReplacementRepelItem]
+	ld [wCurItem], a
+	ld a, -1 ; make TossItem search by ID instead of a stale menu index
+	ld [wCurItemQuantity], a
+	ld a, 1
+	ld [wItemQuantityChange], a
+	ld hl, wNumItems
+	call TossItem
+	ret nc
+	ld a, [wReplacementRepelSteps]
+	ld [wRepelEffect], a
+	ret
+
+; Build a category view into spare tail of the existing battle union.
+; No live battle fields are overwritten. Item operations use the real index.
+BuildCategorizedBag::
+	xor a
+	ld [wFilteredNumItems], a
+	ld hl, wItems
+	ld de, wFilteredItems
+	ld b, 0
+.next
+	ld a, [hli]
+	cp -1
+	jr z, .end
+	push bc
+	push de
+	push hl
+	ld c, a
+	call GetBagItemCategory
+	ld e, a
+	ld a, [wBagCategory]
+	and a
+	jr z, .include
+	cp e
+	jr z, .include
+	pop hl
+	pop de
+	pop bc
+	inc hl
+	inc b
+	jr .next
+.include
+	pop hl
+	pop de
+	pop bc
+	dec hl
+	ld a, [hli]
+	ld [de], a
+	inc de
+	ld a, [hli]
+	ld [de], a
+	inc de
+	push hl
+	push de
+	ld a, [wFilteredNumItems]
+	ld e, a
+	ld d, 0
+	ld hl, wFilteredItemIndices
+	add hl, de
+	ld [hl], b
+	ld hl, wFilteredNumItems
+	inc [hl]
+	pop de
+	pop hl
+	inc b
+	jr .next
+.end
+	ld a, -1
+	ld [de], a
+	ret
+
+CategorizedBagRealIndex::
+	ld a, [wMenuJoypad]
+	and PAD_A
+	ret z
+	ld a, [wCurItemQuantity]
+	ld e, a
+	ld d, 0
+	ld hl, wFilteredItemIndices
+	add hl, de
+	ld a, [hl]
+	ld [wCurItemQuantity], a
+	ret
+
+NextBagCategory::
+	; Kept as a compatibility entry point for older test tools.  Categories now
+	; change with left/right in the pack instead of START.
+	ld a, [wBagCategory]
+	inc a
+	cp 5
+	jr c, .store
+	ld a, 1
+.store
+	ld [wBagCategory], a
+	ret
+
+; C=item, output A:1 health,2 berries,3 battle/held,4 other.
+GetBagItemCategory::
+	push bc
+	push de
+	push hl
+	ld hl, .Berries
+	call .Search
+	ld a, 2
+	jr c, .done
+	ld hl, .Medicine
+	call .Search
+	ld a, 1
+	jr c, .done
+	ld hl, .Other
+	call .Search
+	ld a, 4
+	jr c, .done
+	ld a, 3
+.done
+	pop hl
+	pop de
+	pop bc
+	ret
+.Search
+	ld a, [hli]
+	and a
+	ret z
+	cp c
+	jr nz, .Search
+	scf
+	ret
+.Berries
+	db BERRY, GOLD_BERRY, PSNCUREBERRY, PRZCUREBERRY, BURNT_BERRY
+	db ICE_BERRY, BITTER_BERRY, MINT_BERRY, MIRACLEBERRY, MYSTERYBERRY, 0
+.Medicine
+	db POTION, SUPER_POTION, HYPER_POTION, MAX_POTION, FULL_RESTORE
+	db ANTIDOTE, PARLYZ_HEAL, AWAKENING, BURN_HEAL, ICE_HEAL, FULL_HEAL
+	db FRESH_WATER, SODA_POP, LEMONADE, MOOMOO_MILK, RAGECANDYBAR
+	db ENERGYPOWDER, ENERGY_ROOT, HEAL_POWDER, REVIVAL_HERB
+	db REVIVE, MAX_REVIVE, BERRY_JUICE, ETHER, MAX_ETHER, ELIXER, MAX_ELIXER
+	db HP_UP, PROTEIN, IRON, CARBOS, CALCIUM, RARE_CANDY, PP_UP, 0
+.Other
+	db MOON_STONE, FIRE_STONE, THUNDERSTONE, WATER_STONE, LEAF_STONE, SUN_STONE
+	db FLOWER_MAIL, SURF_MAIL, LITEBLUEMAIL, PORTRAITMAIL, LOVELY_MAIL
+	db EON_MAIL, MORPH_MAIL, BLUESKY_MAIL, MUSIC_MAIL, MIRAGE_MAIL
+	db ESCAPE_ROPE, REPEL, SUPER_REPEL, MAX_REPEL, NUGGET, SILVER_LEAF
+	db GOLD_LEAF, TINYMUSHROOM, BIG_MUSHROOM, PEARL, BIG_PEARL, STARDUST
+	db STAR_PIECE, BRICK_PIECE, NORMAL_BOX, GORGEOUS_BOX, SLOWPOKETAIL
+	db RED_APRICORN, BLU_APRICORN, YLW_APRICORN, GRN_APRICORN
+	db WHT_APRICORN, BLK_APRICORN, PNK_APRICORN, 0
+
+PackSetCategoryOnEntry::
+; The pockets form one circle: MEDICINA, BAYAS, COMBATE, OTROS, BALLS, CLAVE,
+; MT/MO. Coming back from BALLS (left) lands on OTROS and coming from MT/MO
+; (right) lands on MEDICINA. Changing category inside ITEMS keeps the choice.
+	ld a, [wCurPocket]
+	cp BALL_POCKET
+	jr z, .from_balls
+	cp TM_HM_POCKET
+	ret nz
+	ld a, 1
+	jr .store
+.from_balls
+	ld a, 4
+.store
+	ld [wBagCategory], a
+	xor a
+	ld [wItemsPocketCursor], a
+	ld [wItemsPocketScrollPosition], a
+	ret
+DrawBagCategoryName::
+; The category name is drawn in the black pocket box (replacing "Objetos"),
+; using five pre-drawn label tiles per category starting at tile $60.
+	ld a, [wCurPocket]
+	and a
+	ret nz
+	ld a, [wBagCategory]
+	and a
+	jr nz, .not_zero
+	inc a
+.not_zero
+	cp 5
+	jr c, .ok
+	ld a, 1
+	ld [wBagCategory], a
+.ok
+	dec a
+	ld c, a
+	add a
+	add a
+	add c ; five tiles per label
+	add $60
+	hlcoord 0, 8
+	ld c, 5
+.loop
+	ld [hli], a
+	inc a
+	dec c
+	jr nz, .loop
+	ret
+SECTION UNION "Miscellaneous", WRAM0
+; Live battle data ends before this tail; menus recreate the map on return.
+	ds $139 ; fixed tail boundary, asserted against linked battle struct
+	assert @ == wBattleEnd
+wFilteredNumItems:: db
+wFilteredItems:: ds MAX_ITEMS * 2 + 1
+wFilteredItemIndices:: ds MAX_ITEMS
+	assert @ - wSurroundingTiles <= SURROUNDING_WIDTH * SURROUNDING_HEIGHT
+POPS
