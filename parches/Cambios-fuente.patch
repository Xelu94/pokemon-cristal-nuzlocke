diff --git a/engine/battle/modern_items.asm b/engine/battle/modern_items.asm
new file mode 100644
index 0000000..6a82fae
--- /dev/null
+++ b/engine/battle/modern_items.asm
@@ -0,0 +1,280 @@
+; Modern held-item mechanics. All persistent item IDs and party layouts stay stable.
+
+ModernChoiceAttackBoost::
+; Input/output HL attack, BC defense, DE power/level. Apply before truncation.
+	push bc
+	push de
+	ldh a, [hBattleTurn]
+	and a
+	ld a, [wBattleMonItem]
+	ld de, wPlayerMoveStructType
+	jr z, .user
+	ld a, [wEnemyMonItem]
+	ld de, wEnemyMoveStructType
+.user
+	ld b, a
+	ld a, [de]
+	and PHYSICAL | SPECIAL
+	cp PHYSICAL
+	ld a, b
+	jr nz, .special
+	cp CHOICE_BAND
+	jr .compare
+.special
+	cp CHOICE_SPECS
+.compare
+	call z, ModernMultiplyThreeHalves
+	pop de
+	pop bc
+	ret
+
+ModernMultiplyThreeHalves:
+; HL = floor(3 * HL / 2), saturated at 65535. Preserve BC.
+	push bc
+	ld b, h
+	ld c, l
+	srl b
+	rr c
+	add hl, bc
+	jr nc, .done
+	ld hl, $ffff
+.done
+	pop bc
+	ret
+
+ModernConfusionAttackBoost::
+; Confusion is physical typeless damage; Specs must never boost it.
+	ldh a, [hBattleTurn]
+	and a
+	ld a, [wBattleMonItem]
+	jr z, .item
+	ld a, [wEnemyMonItem]
+.item
+	cp CHOICE_BAND
+	call z, ModernMultiplyThreeHalves
+	ret
+
+ModernCompareSpeeds::
+; Compare player speed against enemy speed; same flags as CompareBytes.
+	ld hl, wBattleMonSpeed
+	ld a, [hli]
+	ld l, [hl]
+	ld h, a
+	ld a, [wBattleMonItem]
+	cp CHOICE_SCARF
+	call z, ModernMultiplyThreeHalves
+	push hl
+	ld hl, wEnemyMonSpeed
+	ld a, [hli]
+	ld l, [hl]
+	ld h, a
+	ld a, [wEnemyMonItem]
+	cp CHOICE_SCARF
+	call z, ModernMultiplyThreeHalves
+	pop de
+	ld a, d
+	cp h
+	ret nz
+	ld a, e
+	cp l
+	ret
+
+ModernIsChoiceItem:
+	cp CHOICE_BAND
+	ret z
+	cp CHOICE_SPECS
+	ret z
+	cp CHOICE_SCARF
+	ret
+
+ModernRememberChoice::
+; Called only once the turn can execute, before Metronome changes the move.
+	push hl
+	push bc
+	ldh a, [hBattleTurn]
+	and a
+	ld hl, wPlayerChoiceMove
+	ld a, [wCurPlayerMove]
+	ld c, a
+	ld a, [wBattleMonItem]
+	jr z, .user
+	ld hl, wEnemyChoiceMove
+	ld a, [wCurEnemyMove]
+	ld c, a
+	ld a, [wEnemyMonItem]
+.user
+	call ModernIsChoiceItem
+	jr z, .choice
+	xor a
+	ld [hl], a
+	jr .done
+.choice
+	ld a, [hl]
+	and a
+	jr nz, .done
+	ld a, c
+	and a
+	jr z, .done
+	cp STRUGGLE
+	jr z, .done
+	cp CANNOT_MOVE
+	jr z, .done
+	ld [hl], a
+.done
+	pop bc
+	pop hl
+	ret
+
+ModernPlayerChoiceState::
+; B = 0 unrestricted, 1 usable lock, 2 locked move unusable; C move slot.
+	ld b, 0
+	ld a, [wBattleMonItem]
+	call ModernIsChoiceItem
+	jr z, .choice
+	xor a
+	ld [wPlayerChoiceMove], a
+	ret
+.choice
+	ld a, [wPlayerChoiceMove]
+	and a
+	ret z
+	ld d, a
+	ld hl, wBattleMonMoves
+	ld c, 0
+.loop
+	ld a, [hli]
+	cp d
+	jr z, .found
+	inc c
+	ld a, c
+	cp NUM_MOVES
+	jr c, .loop
+	ld b, 2
+	ret
+.found
+	ld b, 2
+	ld a, [wDisabledMove]
+	cp d
+	ret z
+	ld hl, wBattleMonPP
+	ld d, 0
+	ld e, c
+	add hl, de
+	ld a, [hl]
+	and PP_MASK
+	ret z
+	ld b, 1
+	ret
+
+ModernValidatePlayerChoice::
+; C selected move. B=1 rejects selecting another move; C preserved.
+	ld b, 0
+	ld a, [wBattleMonItem]
+	call ModernIsChoiceItem
+	ret nz
+	ld a, [wPlayerChoiceMove]
+	and a
+	ret z
+	cp c
+	ret z
+	inc b
+	ret
+
+ModernEnemyChoiceAction::
+; B=1 -> use C move in slot D; C=STRUGGLE if disabled or out of PP.
+	ld b, 0
+	ld a, [wEnemyMonItem]
+	call ModernIsChoiceItem
+	jr z, .choice
+	xor a
+	ld [wEnemyChoiceMove], a
+	ret
+.choice
+	ld a, [wEnemyChoiceMove]
+	and a
+	ret z
+	ld e, a
+	ld hl, wEnemyMonMoves
+	ld d, 0
+.loop
+	ld a, [hli]
+	cp e
+	jr z, .found
+	inc d
+	ld a, d
+	cp NUM_MOVES
+	jr c, .loop
+	ld b, 1
+	jr .struggle
+.found
+	ld b, 1
+	ld a, [wEnemyDisabledMove]
+	cp e
+	jr z, .struggle
+	ld c, e
+	ld e, d
+	ld d, 0
+	ld hl, wEnemyMonPP
+	add hl, de
+	ld d, e
+	ld a, [hl]
+	and PP_MASK
+	ret nz
+.struggle
+	ld c, STRUGGLE
+	ld d, 0
+	ret
+
+ModernTryFocusSash::
+; B=1 if a full-health defender survives a lethal direct hit. Consume once.
+	ld b, 0
+	ld a, BATTLE_VARS_SUBSTATUS4_OPP
+	call GetBattleVar
+	bit SUBSTATUS_SUBSTITUTE, a
+	ret nz
+	ldh a, [hBattleTurn]
+	and a
+	ld a, [wEnemyMonItem]
+	ld hl, wEnemyMonHP
+	jr z, .opponent
+	ld a, [wBattleMonItem]
+	ld hl, wBattleMonHP
+.opponent
+	cp FOCUS_SASH
+	jr z, .has_sash
+	cp FOCUS_BAND ; old saves may still hold the legacy CINTA-FOCUS
+	ret nz
+.has_sash
+	ld a, [hli]
+	ld d, a
+	ld a, [hli]
+	ld e, a
+	ld a, d
+	or e
+	ret z
+	ld a, [hli]
+	cp d
+	ret nz
+	ld a, [hl]
+	cp e
+	ret nz
+	ld hl, wCurDamage
+	ld a, [hli]
+	cp d
+	jr c, .no
+	jr nz, .lethal
+	ld a, [hl]
+	cp e
+	jr c, .no
+.lethal
+	dec de
+	ld hl, wCurDamage
+	ld [hl], d
+	inc hl
+	ld [hl], e
+	farcall ConsumeHeldItem
+	ld b, 1
+	ret
+.no
+	ld b, 0
+	ret
