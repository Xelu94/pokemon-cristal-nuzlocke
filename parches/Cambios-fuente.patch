diff --git a/engine/events/super_league.asm b/engine/events/super_league.asm
new file mode 100644
index 0000000..4b0ff3a
--- /dev/null
+++ b/engine/events/super_league.asm
@@ -0,0 +1,192 @@
+; The Super League: strong random opponents, the Full Restore loss rule and its scripts.
+
+PUSHS
+SECTION "Super League", ROMX
+
+SuperLeagueRandomizeSpecies::
+; Called for every Pokemon of a party read with TRAINERTYPE_NORMAL. The four Super League
+; trainers get a random, fully evolved species with a base stat total of at least 450 that
+; is not already in the party, instead of the placeholder stored in the party data.
+	ld a, [wOtherTrainerClass]
+	ld b, a
+	ld a, [wOtherTrainerID]
+	ld c, a
+	ld hl, .Trainers
+.check
+	ld a, [hli]
+	and a
+	ret z
+	cp b
+	jr nz, .next
+	ld a, [hl]
+	cp c
+	jr z, .match
+.next
+	inc hl
+	jr .check
+.match
+.pick
+	call Random
+	and a
+	jr z, .pick
+	cp CELEBI + 1
+	jr nc, .pick
+	ld [wCurSpecies], a
+	ld d, a
+	; not already on the enemy team
+	ld a, [wOTPartyCount]
+	and a
+	jr z, .no_dupes
+	ld c, a
+	ld hl, wOTPartySpecies
+.dupes
+	ld a, [hli]
+	cp d
+	jr z, .pick
+	dec c
+	jr nz, .dupes
+.no_dupes
+	; fully evolved: its evolution list is empty
+	ld a, d
+	dec a
+	ld l, a
+	ld h, 0
+	add hl, hl
+	ld de, EvosAttacksPointers
+	add hl, de
+	ld a, BANK(EvosAttacksPointers)
+	call GetFarWord
+	ld a, BANK(EvosAttacksPointers)
+	call GetFarByte
+	and a
+	jr nz, .pick
+	call GetBaseData
+	; base stat total >= 450
+	ld hl, wBaseStats
+	ld b, 6
+	ld de, 0
+.sum
+	ld a, [hli]
+	add e
+	ld e, a
+	jr nc, .no_carry
+	inc d
+.no_carry
+	dec b
+	jr nz, .sum
+	ld a, d
+	cp HIGH(450)
+	jr c, .pick
+	jr nz, .accept
+	ld a, e
+	cp LOW(450)
+	jr c, .pick
+.accept
+	ld a, [wCurSpecies]
+	ld [wCurPartySpecies], a
+	ret
+
+.Trainers:
+	db CHAMPION, LANCE_SUPER
+	db RED, RED_SUPER
+	db BLUE, BLUE_SUPER
+	db ULEX, ULEX_SUPER
+	db 0
+
+RemoveAllFullRestores::
+; The Super League takes back every Full Restore from the bag.
+	ld a, FULL_RESTORE
+	ld [wCurItem], a
+	ld c, 99
+.loop
+	push bc
+	ld a, 1
+	ld [wItemQuantityChange], a
+	ld hl, wNumItems
+	call TossItem
+	pop bc
+	ret nc
+	dec c
+	jr nz, .loop
+	ret
+
+SuperLeagueLostScript:
+	clearevent EVENT_EXHIBITION_BATTLE
+	opentext
+	writetext SuperLeagueLostText
+	waitbutton
+	closetext
+	callasm RemoveAllFullRestores
+	clearevent EVENT_SUPER_LEAGUE_RESTORES_GIVEN
+	clearevent EVENT_SUPER_BEAT_AZUL
+	clearevent EVENT_SUPER_BEAT_LANCE
+	clearevent EVENT_SUPER_BEAT_ROJO
+	clearevent EVENT_SUPER_BEAT_ULEX
+	clearevent EVENT_SUPER_BEAT_TITO_ROOM
+	setevent EVENT_SUPER_LEAGUE_LOST
+	special HealParty
+	playsound SFX_WARP_TO
+	special FadeOutToWhite
+	waitsfx
+	warp INDIGO_PLATEAU_POKECENTER_1F, 6, 10
+	end
+
+SuperLeagueLostText:
+	text "Has caído en la"
+	line "SUPERLIGA."
+
+	para "Conservas tus"
+	line "#MON, pero los"
+	cont "RESTAU. TODO se"
+	cont "quedan aquí."
+
+	para "Para volver a"
+	line "participar, gana"
+	cont "otra vez a TITO"
+	cont "XELUIS."
+	done
+
+SuperLeagueEnterScript::
+	checkevent EVENT_BEAT_TITO_XELUIS
+	iffalse .Locked
+	checkevent EVENT_SUPER_LEAGUE_LOST
+	iftrue .Locked
+	writetext SuperLeagueEnterAskText
+	yesorno
+	iffalse .Cancel
+	closetext
+	playsound SFX_WARP_TO
+	special FadeOutToWhite
+	waitsfx
+	warp SUPER_LEAGUE_LOBBY, 5, 16
+	end
+
+.Locked:
+	writetext SuperLeagueLockedText
+	waitbutton
+.Cancel:
+	closetext
+	end
+
+SuperLeagueEnterAskText:
+	text "La SUPERLIGA está"
+	line "abierta para ti."
+
+	para "Cuatro retadores"
+	line "al nivel 100 y"
+	cont "un campeón."
+
+	para "¿Quieres entrar?"
+	done
+
+SuperLeagueLockedText:
+	text "La SUPERLIGA sólo"
+	line "se abre a quien"
+	cont "ha vencido a TITO"
+	cont "XELUIS."
+
+	para "Si cayó allí"
+	line "dentro, que le"
+	cont "gane de nuevo."
+	done
+POPS
diff --git a/engine/events/tito_xeluis.asm b/engine/events/tito_xeluis.asm
