+	text "¿Qué…? ¡No puede"
+	line "ser! Ni a nivel"
+	cont "100 puedo contigo…"
+	done
+
+SuperAzulLossText:
+	text "¡Ja! Sigues sin"
+	line "ser rival para mí."
+	done
+
+SuperAzulAfterText:
+	text "Tienes talento."
+	line "Pero ojo: LANCE"
+	cont "no se anda con"
+	cont "contemplaciones."
+	done
+
+SuperLeagueAzul_MapEvents:
+	db 0, 0 ; filler
+
+	def_warp_events
+	warp_event  4, 17, SUPER_LEAGUE_LOBBY, 3
+	warp_event  5, 17, SUPER_LEAGUE_LOBBY, 4
+	warp_event  4,  2, SUPER_LEAGUE_LANCE, 1
+	warp_event  5,  2, SUPER_LEAGUE_LANCE, 2
+
+	def_coord_events
+
+	def_bg_events
+
+	def_object_events
+	object_event  5,  7, SPRITE_BLUE, SPRITEMOVEDATA_STANDING_DOWN, 0, 0, -1, -1, PAL_NPC_BLUE, OBJECTTYPE_SCRIPT, 0, SuperAzulScript, -1
